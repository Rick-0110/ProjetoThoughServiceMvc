@{
    Layout = null;
}

@model IEnumerable<ToughService.Models.Produtos.ProdutoBaseModel>

@{
    ViewData["Title"] = "Gerenciar Produtos - Área Administrativa";
    
    var produtosPorCategoria = ViewBag.ProdutosPorCategoria as Dictionary<ToughService.Models.CategoriaEnum, List<ToughService.Models.Produtos.ProdutoBaseModel>>;
    
    string GetCategoriaNome(ToughService.Models.CategoriaEnum cat)
    {
        return cat switch
        {
            ToughService.Models.CategoriaEnum.Extintores => "Extintores de Incêndio",
            ToughService.Models.CategoriaEnum.Mangueiras => "Mangueiras de Combate a Incêndio",
            ToughService.Models.CategoriaEnum.Acessorios => "Acessórios (Abrigos, Placas, Suportes)",
            ToughService.Models.CategoriaEnum.Hidrantes => "Hidrantes",
            ToughService.Models.CategoriaEnum.SistemasFixos => "Sistemas Fixos de Combate a Incêndio",
            ToughService.Models.CategoriaEnum.SistemasDeDeteccao => "Sistemas de Detecção de Fumaça",
            ToughService.Models.CategoriaEnum.EquipamentosArMandado => "Equipamentos para Ar Mandado",
            ToughService.Models.CategoriaEnum.PortasCortaFogo => "Portas Corta-Fogo",
            ToughService.Models.CategoriaEnum.EPI => "EPI - Equipamento de Proteção Individual",
            ToughService.Models.CategoriaEnum.EPR => "EPR - Equipamento de Proteção Respiratória",
            ToughService.Models.CategoriaEnum.EPC => "EPC - Equipamento de Proteção Coletiva",
            _ => cat.ToString()
        };
    }
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Produtos - Área Administrativa</title>
    <link rel="stylesheet" href="~/css/ADM.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

   
</head>
<body>
    <header class="admin-header">
        <div class="header-content">
            <div class="logo-section">
                <img src="~/IMG/LOGO (2).png" alt="Tough Service" class="logo">
                <h1>Gerenciar Produtos</h1>
            </div>
            <div class="user-info">
                <a class="back-btn" asp-action="ADM" asp-controller="ADM">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a asp-action="Index" asp-controller="Home" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i> Sair
                </a>
            </div>
        </div>
    </header>

    <main class="admin-main">
        <div class="container">

            @* 🚨 CORREÇÃO: ADICIONANDO AS MENSAGENS DE FEEDBACK (TempData) 🚨 *@
            @if (TempData["SucessoFormProduto"] != null)
            {
                <div class="alert success-alert">
                    <i class="fas fa-check-circle"></i> @TempData["SucessoFormProduto"]
                </div>
            }

            @if (TempData["ErroStatus"] != null)
            {
                <div class="alert error-alert">
                    <i class="fas fa-times-circle"></i> @TempData["ErroStatus"]
                </div>
            }
            @* ------------------------------------------------------------- *@

            <div class="tabs">
                <button class="tab-btn active" onclick="showTab('adicionar')">
                    <i class="fas fa-plus"></i> Adicionar Produto
                </button>
                <button class="tab-btn" onclick="showTab('listar')">
                    <i class="fas fa-list"></i> Listar Produtos
                </button>
            </div>

            <div id="tab-adicionar" class="tab-content active">
                <div class="form-section">
                    <h2>Adicionar Novo Produto</h2>

                    <form id="formAdicionarProduto" asp-action="AdicionarProdutoADM" asp-controller="ADM" method="post" enctype="multipart/form-data" onsubmit="return confirmarAdicionarProduto(event)">
                        @Html.AntiForgeryToken()
                        <div class="form-grid">

                            <div class="form-group">
                                <label for="nome">Nome do Produto *</label>
                                <input type="text" id="nome" name="Nome" required>
                            </div>

                            <div class="form-group">
                                <label for="categoria">Categoria *</label>
                                <select id="categoria" name="CategoriaId" required>
                                    <option value="">Selecione uma categoria</option>
                                    <option value="1">Extintores de Incêndio</option>
                                    <option value="2">Mangueiras de Combate a Incêndio</option>
                                    <option value="3">Acessórios (Abrigos, Placas, Suportes)</option>
                                    <option value="4">Hidrantes</option>
                                    <option value="5">Sistemas Fixos de Combate a Incêndio</option>
                                    <option value="6">Sistemas de Detecção de Fumaça</option>
                                    <option value="7">Equipamentos para Ar Mandado</option>
                                    <option value="8">Portas Corta-Fogo</option>
                                    <option value="9">EPI - Equipamento de Proteção Individual</option>
                                    <option value="10">EPR - Equipamento de Proteção Respiratória</option>
                                    <option value="11">EPC - Equipamento de Proteção Coletiva</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="sku_tipo">Tipo/Prefix (SKU) *</label>
                                <input type="text" id="sku_tipo" name="Sku_Tipo" required placeholder="Ex: EAT (Extintor Automático) / MGA (Mangueira)">
                                <small style="display: block; margin-top: 0.25rem; color: #6c757d; font-size: 0.875rem;">O SKU será gerado automaticamente com base nestes campos</small>
                            </div>

                            <div class="form-group">
                                <label for="sku_agente">Agente Extintor (SKU) *</label>
                                <input type="text" id="sku_agente" name="Sku_Agente" required placeholder="Ex: PO (Pó Químico) / CO2 / AGUA">
                            </div>

                            <div class="form-group">
                                <label for="sku_capacidade">Capacidade (SKU) *</label>
                                <input type="text" id="sku_capacidade" name="Sku_Capacidade" required placeholder="Ex: 06KG (Capacidade) / 10MT (Comprimento)">
                            </div>

                            <div class="form-group">
                                <label for="sku_modelo">Modelo (SKU) *</label>
                                <input type="text" id="sku_modelo" name="Sku_Modelo" required placeholder="Ex: MOD2">
                            </div>

                            <div class="form-group">
                                <label for="marca">Marca</label>
                                <input type="text" id="marca" name="Marca" placeholder="Digite a marca do produto">
                            </div>

                            <div class="form-group">
                                <label for="preco">Preço (R$) *</label>
                                <input type="number" id="preco" name="Preco" step="0.01" min="0" required>
                            </div>

                            <div class="form-group">
                                <label for="quantidade">Quantidade em Estoque *</label>
                                <input type="number" id="quantidade" name="Quantidade" min="0" required>
                            </div>

                            <div class="form-group">
                                <label for="peso">Peso (kg)</label>
                                <input type="number" id="peso" name="Peso" step="0.01" min="0" placeholder="Ex: 1.5">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="descricao">Descrição *</label>
                            <textarea id="descricao" name="Descricao" rows="4" required></textarea>
                        </div>

                        <div class="form-group">
                            <label for="imagem">Imagem do Produto</label>
                            <input type="file" id="imagem" name="Imagem" accept="image/*">
                            <small>Formatos aceitos: JPG, PNG, GIF (máx. 5MB)</small>
                        </div>

                        <div class="form-group form-group-checkbox">

                            <input type="hidden" name="Ativo" value="false" />

                            <input type="checkbox" id="ativo" name="Ativo" value="true" checked>

                            <label for="ativo">Produto Ativo (visível no site)</label>
                        </div>

                        <div class="form-actions">
                            <button type="reset" class="btn-secondary">Limpar</button>
                            <button type="submit" class="btn-primary">
                                <i class="fas fa-plus"></i> Adicionar produto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div id="tab-listar" class="tab-content">
                <div class="products-section">
                    <div class="section-header">
                        <h2>Produtos Cadastrados</h2>
                    </div>

                    @if (produtosPorCategoria != null && produtosPorCategoria.Any())
                    {
                        @foreach (var categoriaGroup in produtosPorCategoria.OrderBy(c => c.Key))
                        {
                            <div class="category-section-admin" style="margin-bottom: 3rem;">
                                <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 2px solid #8a0404; color: #343a40;">
                                    <i class="fas fa-fire-extinguisher" style="margin-right: 0.5rem; color: #8a0404;"></i>
                                    @GetCategoriaNome(categoriaGroup.Key)
                                    <span style="font-size: 0.9rem; font-weight: 400; color: #6c757d; margin-left: 0.5rem;">
                                        (@categoriaGroup.Value.Count produto@(categoriaGroup.Value.Count != 1 ? "s" : ""))
                                    </span>
                                </h3>

                                <div class="products-grid" id="productsGrid">
                                    @foreach (var produto in categoriaGroup.Value)
                                    {
                                        <div class="product-card-minimal">
                                            <div class="product-image">
                                                <img src="@Url.Content("~/IMG/Produtos/" + produto.ImagemUrl)" alt="@produto.Nome" height="100px" />
                                                <div class="container-gerenciar-produtos">
                                                    <div class="container-produtos">
                                                        <div class="product-overlay">

                                                            <button class="icon-btn edit-btn"
                                                                    onclick="openEditModal(@produto.Id, '@produto.Nome', '@produto.Categoria', @produto.Preco.ToString().Replace(",", "."), @produto.Quantidade, `@produto.Descricao.Replace("`", "\\`")`)"
                                                                    title="Editar">
                                                                <i class="fas fa-edit"></i>
                                                            </button>

                                                            <button class="icon-btn stock-btn"
                                                                    onclick="openAddStockModal(@produto.Id, '@produto.Nome', @produto.Quantidade)"
                                                                    title="Adicionar Estoque">
                                                                <i class="fas fa-box"></i>
                                                            </button>

                                                        </div>
                                                        <form asp-action="ExcluirProduto" asp-controller="ADM" method="post" onsubmit="return confirm('Tem certeza que deseja excluir o produto `@produto.Nome`?');">
                                                            <input type="hidden" name="id" value="@produto.Id" />
                                                            <button type="submit" class="icon-btn delete-btn" title="Excluir">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="product-info">
                                                <h3 class="product-name">@produto.Nome</h3>
                                                <div class="product-rating">
                                                    <div class="stars">★★★★★</div>
                                                </div>
                                                <div class="product-price">@produto.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                                                @if (!string.IsNullOrEmpty(produto.Sku))
                                                {
                                                    <div style="font-size: 0.75rem; color: #6c757d; margin-top: 0.25rem;">
                                                        SKU: @produto.Sku
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (Model != null && Model.Any())
                    {
                        <div class="products-grid" id="productsGrid">
                            @foreach (var produto in Model)
                            {
                                <div class="product-card-minimal">
                                    <div class="product-image">
                                        <img src="@Url.Content("~/IMG/" + produto.ImagemUrl)" alt="@produto.Nome" height="100px" />
                                        <div class="container-gerenciar-produtos">
                                            <div class="container-produtos">
                                                <div class="product-overlay">

                                                    <button class="icon-btn edit-btn"
                                                            onclick="openEditModal(@produto.Id, '@produto.Nome', '@produto.Categoria', @produto.Preco.ToString().Replace(",", "."), @produto.Quantidade, `@produto.Descricao.Replace("`", "\\`")`)"
                                                            title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </button>

                                                    <button class="icon-btn stock-btn"
                                                            onclick="openAddStockModal(@produto.Id, '@produto.Nome', @produto.Quantidade)"
                                                            title="Adicionar Estoque">
                                                        <i class="fas fa-box"></i>
                                                    </button>

                                                </div>
                                                <form asp-action="ExcluirProduto" asp-controller="ADM" method="post" onsubmit="return confirm('Tem certeza que deseja excluir o produto `@produto.Nome`?');">
                                                    <input type="hidden" name="id" value="@produto.Id" />
                                                    <button type="submit" class="icon-btn delete-btn" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="product-info">
                                        <h3 class="product-name">@produto.Nome</h3>
                                        <div class="product-rating">
                                            <div class="stars">★★★★★</div>
                                        </div>
                                        <div class="product-price">@produto.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Nenhum produto cadastrado.</p>
                    }

                </div>
            </div>
    </main>

    <div id="modalEditar" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h2>Editar Produto</h2>
                <span class="close" onclick="closeEditModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="form-editar-produto" onsubmit="updateProduct(event)">
                    <input type="hidden" id="editId" name="id">

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="editNome">Nome do Produto *</label>
                            <input type="text" id="editNome" name="nome" required>
                        </div>

                        <div class="form-group">
                            <label for="editCategoria">Categoria *</label>
                            <select id="editCategoria" name="categoria" required>
                                <option value="Extintores">Extintores de Incêndio</option>
                                <option value="Mangueiras">Mangueiras de Combate a Incêndio</option>
                                <option value="Acessorios">Acessórios (Abrigos, Placas, Suportes)</option>
                                <option value="Hidrantes">Hidrantes</option>
                                <option value="SistemasFixos">Sistemas Fixos de Combate a Incêndio</option>
                                <option value="SistemasDeDeteccao">Sistemas de Detecção de Fumaça</option>
                                <option value="EquipamentosArMandado">Equipamentos para Ar Mandado</option>
                                <option value="PortasCortaFogo">Portas Corta-Fogo</option>
                                <option value="EPI">EPI - Equipamento de Proteção Individual</option>
                                <option value="EPR">EPR - Equipamento de Proteção Respiratória</option>
                                <option value="EPC">EPC - Equipamento de Proteção Coletiva</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="editPreco">Preço (R$) *</label>
                            <input type="number" id="editPreco" name="preco" step="0.01" min="0" required>
                        </div>

                        <div class="form-group">
                            <label for="editQuantidade">Quantidade em Estoque *</label>
                            <input type="number" id="editQuantidade" name="quantidade" min="0" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="editDescricao">Descrição *</label>
                        <textarea id="editDescricao" name="descricao" rows="4" required></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="closeEditModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-save"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="modalAdicionarEstoque" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Adicionar Estoque</h2>
                <span class="close" onclick="closeAddStockModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="form-adicionar-estoque" asp-action="AdicionarEstoque" asp-controller="ADM" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="stockProdutoId" name="produtoId">

                    <div class="form-group">
                        <label>Produto</label>
                        <input type="text" id="stockProdutoNome" readonly style="background-color: #f8f9fa; cursor: not-allowed;">
                    </div>

                    <div class="form-group">
                        <label>Estoque Atual</label>
                        <input type="text" id="stockQuantidadeAtual" readonly style="background-color: #f8f9fa; cursor: not-allowed;">
                    </div>

                    <div class="form-group">
                        <label for="stockQuantidade">Quantidade a Adicionar *</label>
                        <input type="number" id="stockQuantidade" name="quantidade" min="1" required placeholder="Digite a quantidade">
                        <small style="display: block; margin-top: 0.25rem; color: #6c757d; font-size: 0.875rem;">Digite a quantidade de unidades a adicionar ao estoque</small>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="closeAddStockModal()">Cancelar</button>
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-plus"></i> Adicionar ao Estoque
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/js/AdmAdicionarProdutos.js"></script>
</body>
</html>