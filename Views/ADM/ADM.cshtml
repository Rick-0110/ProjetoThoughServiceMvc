@model ToughService.Models.AdminDashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Área Administrativa - Tough Service</title>
    <link rel="stylesheet" href="~/css/ADM.css">
  
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

</head>
<body>
    <!-- Header -->
    <header class="admin-header">
        <div class="header-content">
            <div class="logo-section">
                <img src="~/IMG/LOGO (2).png" alt="Tough Service" class="logo">
                <h1>Área Administrativa</h1>
            </div>
            <div class="user-info">
                <span class="welcome">Bem-vindo, Admin</span>
                <a class="logout-btn" asp-action="Index" asp-controller="Home">
                    <i class="fas fa-sign-out-alt"></i> Sair
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="admin-main">
        <div class="container">
            <!-- Dashboard Cards -->
            <div class="dashboard-grid">
                <!-- Card: Ver Chamados -->
                <a asp-controller="ADM" asp-action="AdmChamados" class="admin-card-link">
                    <div class="admin-card">
                        <div class="card-icon">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="card-content">
                            <h3>Ver Chamados</h3>
                            <p>Visualizar e gerenciar solicitações de orçamento e agendamentos</p>
                            <div class="card-stats">
                                <span class="stat-number" id="totalChamados">@(Model?.TotalChamados ?? 0)</span>
                                <span class="stat-label">Chamados</span>
                            </div>
                        </div>
                        <div class="card-action">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </a>

                <!-- Card: Adicionar Produto -->
                <a asp-controller="ADM" asp-action="GerenciarProdutos"  class="admin-card">
                    <div class="card-icon">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <div class="card-content">
                        <h3>Gerenciar Produtos</h3>
                        <p>Adicionar, editar e remover produtos do catálogo</p>
                        <div class="card-stats">
                            <span class="stat-number" id="totalProdutos">@(Model?.TotalProdutosEmEstoque ?? 0)</span>
                            <span class="stat-label">Produtos</span>
                        </div>
                    </div>
                    <div class="card-action">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>
                <!-- Card: Adicionar Produto -->
                <a asp-controller="ADM" asp-action="GerenciarPedidos" class="admin-card">
                    <div class="card-icon">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <div class="card-content">
                        <h3>Gerenciar Pedidos</h3>
                        <p>Gerenciar as pedidos feitos</p>
                        <div class="card-stats">
                            <span class="stat-number" id="totalPedidos">@(Model?.TotalPedidos ?? 0)</span>
                            <span class="stat-label">Produtos</span>
                        </div>
                    </div>
                    <div class="card-action">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>

                <!-- Card: Relatórios -->
                <div class="admin-card" onclick="navigateTo('relatorios')">
                    <div class="card-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <div class="card-content">
                        <h3>Relatórios</h3>
                        <p>Visualizar relatórios de vendas e chamados</p>
                        <div class="card-stats">
                            <span class="stat-number">-</span>
                            <span class="stat-label">Em breve</span>
                        </div>
                    </div>
                    <div class="card-action">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>

                <!-- Card: Configurações -->
                <div class="admin-card" onclick="navigateTo('configuracoes')">
                    <div class="card-icon">
                        <i class="fas fa-cog"></i>
                    </div>
                    <div class="card-content">
                        <h3>Configurações</h3>
                        <p>Configurar sistema e preferências</p>
                        <div class="card-stats">
                            <span class="stat-number">-</span>
                            <span class="stat-label">Em breve</span>
                        </div>
                    </div>
                    <div class="card-action">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </div>

          

            <!-- Recent Activity -->
            <div class="recent-activity">
                <h2>Atividade Recente</h2>
                <div class="activity-list" id="activityList">

                    @if (Model != null && Model.AtividadesRecentes != null && Model.AtividadesRecentes.Any())
                    {
                        @foreach (var atividade in Model.AtividadesRecentes)
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="@atividade.IconeCss @atividade.CorCss"></i>
                                </div>
                                <div class="activity-content">
                                    <p><strong>@atividade.Tipo:</strong> @atividade.Mensagem</p>
                                    <span class="activity-time">
                                        @* Lógica simples para mostrar tempo relativo *@
                                        @{
                                            var diff = DateTime.Now - atividade.Data;
                                            string tempoTexto = "";
                                            if (diff.TotalMinutes < 60) { tempoTexto = $"Há {Math.Ceiling(diff.TotalMinutes)} min"; }
                                            else if (diff.TotalHours < 24) { tempoTexto = $"Há {Math.Ceiling(diff.TotalHours)} horas"; }
                                            else { tempoTexto = atividade.Data.ToString("dd/MM/yyyy HH:mm"); }
                                        }
                                        @tempoTexto
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="padding: 1rem;">Nenhuma atividade recente.</p>
                    }

                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="admin-footer">
        <div class="container">
            <p>&copy; 2024 Tough Service - Área Administrativa</p>
        </div>
    </footer>

    <script src="~/js/ADM.js"></script>
</body>
</html>
