@model List<ProjetoThoughServiceMvc.Models.ProdutoModel>
@using ProjetoThoughServiceMvc.Models
@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
    <title>Histórico de Pedidos</title>
    <link href="~/css/VerHistoricoPedidos.css" rel="stylesheet" />
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="icon" href="~/IMG/LOGO (2).png" />
</head>
<body>
    <!-- Navigation-->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li><img src="~/IMG/LOGO (2).png" alt="" width="40px"></li>


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-action="Index" asp-controller="Home">Home</a>
                        </li>
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-action="Registro" asp-controller="Registro">Registro</a></li>
                            <li class="nav-item"><a class="nav-link" asp-action="Login" asp-controller="Registro">Login</a></li>
                        }
                        else
                        {
                            <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                        }


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                               asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        </li>
                        <li class="nav-item dropdown">

                        </li>
                    </ul>
                    <div class="nav-cart">
                        @if (!isLoggedIn)
                        {


                            <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Carrinho</span>
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-count">@quantidadeItensCarrinho</span>
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>
  
    <div class="page-header">
        <h1><i class="bi bi-receipt"></i> Histórico de Pedidos</h1>
        <p class="text-muted">Acompanhe seus pedidos e o status de cada compra.</p>
    </div>

    <div class="orders-wrapper">
        <div class="orders-filters">
            <input type="text" placeholder="Buscar por ID ou produto" />
            <select>
                <option value="">Todos os status</option>
                <option>Pago</option>
                <option>Pendente</option>
                <option>Cancelado</option>
            </select>
            <select>
                <option>Últimos 30 dias</option>
                <option>Últimos 6 meses</option>
                <option>Último ano</option>
            </select>
        </div>

        <div class="orders-list">
            <div class="order-card">
                <div class="order-top">
                    <div class="order-id">Pedido #12345</div>
                    <span class="order-status status-pago">Pago</span>
                </div>
                <div class="order-body">
                    <div class="order-meta">Realizado em 20/09/2025 • Total R$ 199,90</div>
                    <div class="order-actions">
                        <a href="comprovante.html"><i class="bi bi-download"></i> Nota/Comprovante</a>
                        <a href="#"><i class="bi bi-truck"></i> Rastrear</a>
                        <a href="#"><i class="bi bi-eye"></i> Detalhes</a>
                    </div>
                </div>
            </div>

            <div class="order-card">
                <div class="order-top">
                    <div class="order-id">Pedido #12312</div>
                    <span class="order-status status-pendente">Pendente</span>
                </div>
                <div class="order-body">
                    <div class="order-meta">Realizado em 12/09/2025 • Total R$ 89,00</div>
                    <div class="order-actions">
                        <a href="comprovante.html"><i class="bi bi-download"></i> Nota/Comprovante</a>
                        <a href="#"><i class="bi bi-eye"></i> Detalhes</a>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:18px">
            <a href="perfil.html" class="btn btn-secondary">Voltar ao perfil</a>
        </div>
    </div>
</body>
</html>

