<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nota/Comprovante</title>
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="~/css/perfil.css" rel="stylesheet" />
    <link href="~/css/Comprovante.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        function printDoc(){window.print();}
    </script>
</head>
<body>
    <div class="doc-wrap">
        <div class="doc-card" id="comprovante">
            <div class="doc-header">
                <div class="brand">
                    <img src="IMG/LOGO (2).png" alt="Logo" />
                    <div>
                        <strong>Though Service</strong><br />
                        <small>CNPJ 00.000.000/0001-00</small>
                    </div>
                </div>
                <div class="doc-actions">
                    <a href="#" onclick="printDoc()"><i class="bi bi-printer"></i> Imprimir</a>
                    <a href="#"><i class="bi bi-download"></i> Baixar PDF</a>
                    <a asp-action="Perfil" asp-controller="Perfil""><i class="bi bi-arrow-left"></i> Voltar</a>
                </div>
            </div>

            <div class="doc-grid">
                <div class="doc-section">
                    <h3>Dados do Pedido</h3>
                    <div>Pedido #12345</div>
                    <div>Data: 20/09/2025 10:20</div>
                    <div>Status: Pago</div>
                </div>
                <div class="doc-section">
                    <h3>Cliente</h3>
                    <div>João Silva</div>
                    <div>CPF 000.000.000-00</div>
                    <div>email@exemplo.com</div>
                </div>
                <div class="doc-section">
                    <h3>Endereço</h3>
                    <div>Rua Exemplo, 123</div>
                    <div>Camaçari - BA</div>
                    <div>CEP 00000-000</div>
                </div>
                <div class="doc-section">
                    <h3>Pagamento</h3>
                    <div>Cartão VISA final 1234</div>
                    <div>Autorização: 9A7B2C</div>
                </div>
            </div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qtd</th>
                        <th>Preço</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Serviço A</td>
                        <td>1</td>
                        <td>R$ 99,90</td>
                        <td>R$ 99,90</td>
                    </tr>
                    <tr>
                        <td>Serviço B</td>
                        <td>1</td>
                        <td>R$ 100,00</td>
                        <td>R$ 100,00</td>
                    </tr>
                </tbody>
            </table>

            <div class="totals">
                <div>
                    <div class="totals-row"><span>Subtotal</span><span>R$ 199,90</span></div>
                    <div class="totals-row"><span>Descontos</span><span>R$ 0,00</span></div>
                    <div class="totals-row total"><span>Total</span><span>R$ 199,90</span></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


