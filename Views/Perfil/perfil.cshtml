@model ToughService.Models.ApplicationUser

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ToughService.Models.ItemCarrinhoModel>>("Carrinho") ?? new List<ToughService.Models.ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Perfil</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Core theme CSS (includes Bootstrap) -->
    
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="~/css/perfil.css" rel="stylesheet" />
</head>
<body>
    <main>
        <div class="perfil-container">
            <div class="perfil-header">
                <div class="foto-perfil">
                    <img src="~/IMG/perfil2.png" alt="Foto do perfil" />
                    <button class="btn-alterar-foto">
                        <i class="fas fa-camera"></i>
                    </button>
                </div>
                <h1>@Model.Nome</h1>
                <p class="email">@Model.Email</p>
            </div>

            <div class="perfil-info">
                @if (TempData["Mensagem"] != null)
                {
                    <div class="alert alert-success">@TempData["Mensagem"]</div>
                }

                <form asp-action="AtualizarPerfil" asp-controller="Perfil" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="info-card">
                        <h2>Informações Pessoais</h2>
                        <div class="info-item">
                            <label for="Nome">Nome Completo</label>
                            <input asp-for="Nome" id="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="info-item">
                            <label for="CpfCnpj">CPF/CNPJ</label>
                            <input asp-for="CpfCnpj" id="CpfCnpj" class="form-control" />
                            <span asp-validation-for="CpfCnpj" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-salvar">Salvar Alterações</button>
                    </div>
                </form>
            </div>

            <div class="perfil-servicos">
                <div class="info-card">
                    <h2>Pedidos e Pagamentos</h2>
                    <div class="d-grid gap-2 gap-md-3">
                        <a class="btn btn-outline-dark" asp-action="VerHistoricoPedidos" asp-controller="Perfil">
                            <i class="bi bi-receipt" ></i> Ver histórico de pedidos e status da compra
                        </a>
                        <a class="btn btn-outline-dark" href="#">
                            <i class="bi bi-credit-card"></i> Gerenciar formas de pagamento
                        </a>
                        <a class="btn btn-outline-dark" href="#">
                            <i class="bi bi-file-earmark-arrow-down"></i> Baixar nota fiscal ou comprovante
                        </a>
                    </div>
                </div>
            </div>



            <div class="perfil-acoes">
                <form asp-action="Logout" asp-controller="Registro" method="post">
                    <button type="submit" class="btn-sair">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer Minimalista -->
    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>

                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a asp-action="Sobre" asp-controller="Home">Sobre</a>
                        <a asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        <a href="#">Contato</a>
                    </div>

                    <div class="footer-column">
                        <h4>Suporte</h4>
                        <a href="#">FAQ</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>

                    <div class="footer-column">
                        <h4>Redes Sociais</h4>
                        <div class="social-links-minimal">
                            <a href="#" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" aria-label="Facebook">
                                <i class="fab fa-facebook"></i>
                            </a>
                            <a href="#" aria-label="LinkedIn">
                                <i class="fab fa-linkedin"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>


    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/scripts.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
