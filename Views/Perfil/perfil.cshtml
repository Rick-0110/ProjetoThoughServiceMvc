@model ToughService.Models.ApplicationUser

@{
    ViewData["Title"] = "Perfil";
    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");
}

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;
}
@{
    var carrinho = Context.Session.GetObject<List<ToughService.Models.ItemCarrinhoModel>>("Carrinho") ?? new List<ToughService.Models.ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Perfil</title>
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="~/css/perfil.css" rel="stylesheet" />
</head>
<body>
    <main>
        <div class="perfil-container">
            <div class="perfil-header">
                @{
                    var profileImagePath = Model.ProfilePicturePath ?? "/IMG/perfil2.png";
                }
                <div class="foto-perfil">
                    <img id="profileImage" src="@profileImagePath" alt="Foto do perfil" />

                    <button id="btnAlterarFoto" type="button" class="btn-alterar-foto">
                        <i class="fas fa-camera"></i>
                    </button>

                    <form asp-action="UploadProfilePicture" asp-controller="Perfil" method="post" enctype="multipart/form-data" id="uploadForm">
                        <input type="file" name="arquivo" id="arquivoUpload" accept="image/*" style="display: none;" />
                        <button type="submit" id="submitUpload" style="display: none;"></button>
                    </form>
                </div>
                <h1>@Model.Nome</h1>
                <p class="email">@Model.Email</p>
            </div>

            <div class="perfil-info">
                @if (TempData["Mensagem"] != null)
                {
                    <div class="alert alert-success">@TempData["Mensagem"]</div>
                }
                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert alert-success">@TempData["Sucesso"]</div>
                }

                <form asp-action="AtualizarPerfil" asp-controller="Perfil" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="info-card">
                        <h2>Informações Pessoais</h2>
                        <div class="info-item">
                            <label for="Nome">Nome Completo</label>
                            <input asp-for="Nome" id="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="info-item">
                            <label for="CpfCnpj">CPF/CNPJ</label>
                            <input asp-for="CpfCnpj" id="CpfCnpj" class="form-control" />
                            <span asp-validation-for="CpfCnpj" class="text-danger"></span>
                        </div>
                        <div class="info-item">
                            <label for="PhoneNumber">Celular / WhatsApp</label>
                            <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control" placeholder="(00) 00000-0000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-salvar">Salvar Alterações</button>
                    </div>
                </form>
            </div>

         



            <div class="perfil-acoes">
                <form asp-action="Logout" asp-controller="Registro" method="post">
                    <button type="submit" class="btn-sair">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </button>
                </form>
            </div>
        </div>
    </main>


    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/scripts.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const btnAlterarFoto = document.getElementById('btnAlterarFoto');
                const arquivoUpload = document.getElementById('arquivoUpload');
                const uploadForm = document.getElementById('uploadForm');

                if (btnAlterarFoto && arquivoUpload) {
                    btnAlterarFoto.addEventListener('click', function () {
                        arquivoUpload.click();
                    });
                }

                if (arquivoUpload && uploadForm) {
                    arquivoUpload.addEventListener('change', function () {
                        if (arquivoUpload.files.length > 0) {
                            uploadForm.submit();
                        }
                    });
                }
            });
        </script>
    }
</body>
</html>