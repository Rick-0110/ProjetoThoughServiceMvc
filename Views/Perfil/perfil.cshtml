@model ProjetoThoughServiceMvc.Models.ApplicationUser
@using ProjetoThoughServiceMvc.Models;

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Perfil</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Core theme CSS (includes Bootstrap) -->
    
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="~/css/perfil.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li><img src="~/IMG/LOGO (2).png" alt="" width="40px"></li>


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-action="Index" asp-controller="Home">Home</a>
                        </li>
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-action="Registro" asp-controller="Registro">Registro</a></li>
                            <li class="nav-item"><a class="nav-link" asp-action="Login" asp-controller="Registro">Login</a></li>
                        }
                        else
                        {
                            <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                        }


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                               asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        </li>
                        <li class="nav-item dropdown">

                        </li>
                    </ul>
                    <div class="nav-cart">
                        @if (!isLoggedIn)
                        {
                         

                            <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Carrinho</span>
                            </a>
                        }
                        else
                        {
   <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-count">@quantidadeItensCarrinho</span>
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>
    <main>
        <div class="perfil-container">
            <div class="perfil-header">
                <div class="foto-perfil">
                    <img src="~/IMG/perfil2.png" alt="Foto do perfil" />
                    <button class="btn-alterar-foto">
                        <i class="fas fa-camera"></i>
                    </button>
                </div>
                <h1>@Model.Nome</h1>
                <p class="email">@Model.Email</p>
            </div>

            <div class="perfil-info">
                @if (TempData["Mensagem"] != null)
                {
                    <div class="alert alert-success">@TempData["Mensagem"]</div>
                }

                <form asp-action="AtualizarPerfil" asp-controller="Perfil" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="info-card">
                        <h2>Informações Pessoais</h2>
                        <div class="info-item">
                            <label for="Nome">Nome Completo</label>
                            <input asp-for="Nome" id="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="info-item">
                            <label for="CpfCnpj">CPF/CNPJ</label>
                            <input asp-for="CpfCnpj" id="CpfCnpj" class="form-control" />
                            <span asp-validation-for="CpfCnpj" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-salvar">Salvar Alterações</button>
                    </div>
                </form>
            </div>

            <div class="perfil-servicos">
                <div class="info-card">
                    <h2>Pedidos e Pagamentos</h2>
                    <div class="d-grid gap-2 gap-md-3">
                        <a class="btn btn-outline-dark" asp-action="VerHistoricoPedidos" asp-controller="Perfil">
                            <i class="bi bi-receipt" ></i> Ver histórico de pedidos e status da compra
                        </a>
                        <a class="btn btn-outline-dark" href="#">
                            <i class="bi bi-credit-card"></i> Gerenciar formas de pagamento
                        </a>
                        <a class="btn btn-outline-dark" href="#">
                            <i class="bi bi-file-earmark-arrow-down"></i> Baixar nota fiscal ou comprovante
                        </a>
                    </div>
                </div>
            </div>



            <div class="perfil-acoes">
                <form asp-action="Logout" asp-controller="Registro" method="post">
                    <button type="submit" class="btn-sair">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>Contato</h3>
                <p>Email: contato@toughservice.com</p>
                <p>Telefone: (71) 99204-6022</p>
            </div>
            <div class="footer-section">
                <h3>Endereço</h3>
                <p>Rua, 123</p>
                <p>Camaçari - BA</p>
            </div>
        </div>
    </footer>

    <script src="~/js/MinimalistaPrincipal.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
