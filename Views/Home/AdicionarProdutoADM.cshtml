@using ProjetoThoughServiceMvc.Models
@model List<ProjetoThoughServiceMvc.Models.ProdutoModel>

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Adicionar Produto</title>
    <link rel="stylesheet" href="~/css/AdicionarProdutoADM.css">
    <link rel="stylesheet" href="~/css/Minimalista.css">
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<nav class="navbar-minimal">
    <div class="nav-container">
        <!-- Logo -->
        <div class="nav-logo">
            <a asp-action="Index" asp-controller="Home" class="logo-link">

                <img src="~/IMG/LOGO (2).png" alt="" width="60vh">
            </a>
        </div>


        <!-- Menu Principal -->
        <div class="nav-menu">
            <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>

            @if (usuarioEhAdmin)
            {
                <a asp-action="AdicionarProdutoADM" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "AdicionarProdutoADM" ? "active" : "")">Admin</a>
            }

            @if (!isLoggedIn)
            {
                <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
            }
            else
            {
                <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
            }


            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
               asp-action="Servicos" asp-controller="Servicos">Serviços</a>

            <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
        </div>

        <!-- Carrinho -->
        <div class="nav-cart">
            @if (!isLoggedIn)
            {
                <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Login</span>
                </a>
            }
            else
            {
                <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count">@quantidadeItensCarrinho</span>
                </a>
            }
        </div>

        <!-- Menu Mobile -->
        <button class="mobile-menu-btn" type="button">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>
<body>
    
    <form class="form-produto" asp-action="AdicionarProdutoADM" asp-controller="Home" method="post" enctype="multipart/form-data">
        <h1>Adicionar Produto</h1>
        <label for="Nome">Nome do Produto:</label>
        <input type="text" id="Nome" name="Nome" required /><br><br>

        <label for="Descricao">Descrição:</label>
        <textarea id="Descricao" name="Descricao" required></textarea><br><br>

        <label for="Preco">Preço:</label>
        <input type="number" id="Preco" name="Preco" step="0.01" min="0" required /><br><br>

        <label for="Quantidade">Quantidade:</label>
        <input type="number" id="Quantidade" name="Quantidade" min="1" required /><br><br>

        <label for="Imagem">Imagem do Produto:</label>
        <input type="file" id="Imagem" name="Imagem" accept="image/*" /><br><br>

        <button type="submit">Adicionar Produto</button>
    </form>
    <script src="~/js/MinimalistaPrincipal.js"></script>
</body>
</html>
