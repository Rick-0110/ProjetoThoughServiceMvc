@model List<ToughService.Models.Produtos.ProdutoBaseModel>

@{
    ViewData["Title"] = $"Busca por '{ViewBag.TermoBuscado}'";
}

<section class="products-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Resultados para "@ViewBag.TermoBuscado"</h2>
        </div>

        <div class="products-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (var produto in Model)
                {
                    <div class="product-card-minimal">
                        <div class="product-image">
                            <img src="@Url.Content("~/IMG/Produtos/" + produto.ImagemUrl)" alt="@produto.Nome" />
                            <div class="product-overlay">
                                <a asp-action="InfoProduto" asp-controller="Carrinho" asp-route-id="@produto.Id" class="view-btn">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <form asp-action="RemoverProduto" asp-controller="Home" method="post" onsubmit="return confirm('Tem certeza?');" class="admin-form">
                                        <input type="hidden" name="id" value="@produto.Id" />
                                        <button type="submit" class="delete-btn">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@produto.Nome</h3>
                            <div class="product-rating"><div class="stars">★★★★★</div></div>
                            <div class="product-price">R$ @produto.Preco.ToString("F2")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-products">
                    <i class="fas fa-box-open"></i>
                    <p>Nenhum produto encontrado para "@ViewBag.TermoBuscado".</p>
                </div>
            }
        </div>
    </div>
</section>