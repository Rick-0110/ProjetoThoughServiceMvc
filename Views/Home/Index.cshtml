@model List<ToughService.Models.ProdutoModel>

@{
    ViewData["Title"] = "Home";
}

<header class="bg-dark py-5" height="300px">
    <div class="container px-2 px-lg-5 my-0">
        <div class="text-center text-white">
           <title>Home - Tough Service</title>
            <img src="IMG/LOGO (2).png" height="200px" class="LogoThough" />
            <p class="lead fw-normal text-white-50 mb-0">EQUIPAMENTOS E ASSESSORIA DE SEGURANÇA LTDA</p>
            <div class="hero-features">
                <span class="feature-badge">✓ Certificado ISO</span>
                <span class="feature-badge">✓ Entrega Rápida</span>
                <span class="feature-badge">✓ Suporte 24/7</span>
            </div>
        </div>
    </div>
</header>

<section class="products-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Nossos Produtos</h2>
            <p class="section-subtitle">Equipamentos de segurança com qualidade certificada</p>
        </div>

        <div class="products-grid">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var produto in Model)
                {
                    <div class="product-card-minimal">
                        <div class="product-image">
                            <img src="@Url.Content("~/IMG/" + produto.ImagemUrl)" alt="@produto.Nome" />
                            <div class="product-overlay">
                                <a asp-action="InfoProduto" asp-controller="Carrinho" asp-route-id="@produto.Id" class="view-btn">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <form ExcluirProdutoHome method="post" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');" class="admin-form">
                                        <input type="hidden" name="id" value="@produto.Id" />
                                        <button type="submit" class="delete-btn">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@produto.Nome</h3>
                            <div class="product-rating"><div class="stars">★★★★★</div></div>
                            <div class="product-price">R$ @produto.Preco.ToString("F2")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-products">
                    <i class="fas fa-box-open"></i>
                    <p>Nenhum produto disponível no momento.</p>
                </div>
            }
        </div>
    </div>
</section>