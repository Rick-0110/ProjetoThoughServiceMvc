@using ProjetoThoughServiceMvc.Models
@model List<ProjetoThoughServiceMvc.Models.ProdutoModel>

@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
      var isLoggedIn = ViewBag.IsLoggedIn ?? false;
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Though Service</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Core theme CSS (includes Bootstrap) -->
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>
    <!-- Navigation-->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">

            <!-- Área de Pesquisa Centralizada -->
            <section class="search-section">
              <div class="container">
                <div class="search-container">
                  <form class="search-form" asp-action="Buscar" asp-controller="Produto" method="GET">
                    <input type="text" name="busca" class="search-input" placeholder="Buscar produtos..." required />
                    <button class="search-button" type="submit">
                      <i class="bi bi-search search-icon"></i>
                      Buscar
                    </button>
                  </form>
                </div>
              </div>
            </section>

           
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                <li class="nav-item"><a class="nav-link active" aria-current="page" href="#!">Home</a></li>

                @if (usuarioEhAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link active" asp-action="AdicionarProdutoADM" asp-controller="Home">Adicionar Produto</a>
                    </li>
                }

                @if (!isLoggedIn)
                {
                    <li class="nav-item"><a class="nav-link" asp-action="Registro" asp-controller="Registro">Registro</a></li>
                    <li class="nav-item"><a class="nav-link" asp-action="Login" asp-controller="Registro">Login</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-action="Perfil" asp-controller="Perfil">Perfil</a></li>
                }

                <li class="nav-item"><a class="nav-link" asp-action="Servicos" asp-controller="Servicos">Serviços</a></li>
                <li class="nav-item"><a class="nav-link" asp-action="Sobre" asp-controller="Home">Sobre</a></li>
            </ul>

                <form class="d-flex">
                    <a class="btn btn-outline-dark" asp-action="Index" asp-controller="Carrinho">
                        <i class="bi-cart-fill me-1"></i>
                        Carrinho
                        <span class="badge bg-dark text-white ms-1 rounded-pill">@quantidadeItensCarrinho</span>

                    </a>
                </form>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="bg-dark py-5" height="300px">
        <div class="container px-4 px-lg-5 my-5">
            <div class="text-center text-white">
                <img src="IMG/LOGO (2).png" height="150px" alt="" />
                <h1 class="display-4 fw-bolder">TOUGH SERVICE</h1>
                <p class="lead fw-normal text-white-50 mb-0">EQUIPAMENTOS E ASSESSORIA DE SEGURANÇA LTDA</p>
            </div>
        </div>
    </header>

    <!-- Section: Produtos -->
 
<section class="py-5">
    <div class="container px-4 px-lg-5 mt-5">
        <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
            
            <!-- Produto 1 -->
  @if (Model != null && Model.Count > 0)
{
    foreach (var produto in Model)
    {
        <div class="col mb-5">
            <div class="card h-100">
                <img class="card-img-top" src="@Url.Content("~/IMG/" + produto.ImagemUrl)" alt="@produto.Nome" />

                <div class="card-body p-4">
                    <div class="text-center">
                        <h5 class="fw-bolder">@produto.Nome</h5>
                        ⭐⭐⭐⭐⭐<br />
                        R$ @produto.Preco.ToString("F2")
                    </div>
                </div>
                <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                    <div class="text-center">
                        <a class="btn btn-outline-dark mt-auto" asp-action="InfoProduto" asp-controller="Carrinho" asp-route-id="@produto.Id">Visualizar</a>
                       @if (usuarioEhAdmin)

                        {
                    <form asp-action="RemoverProduto" asp-controller="Home" method="post" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');" style="display:inline;">
                        <input type="hidden" name="id" value="@produto.Id" />
                        <button type="submit" class="btn btn-outline-danger mt-2">Excluir</button>
                    </form>
                            }
                        
                       
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>Nenhum produto disponível no momento.</p>
}


    </div>
</section>

   

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h3>Sobre Nós</h3>
                <p>Tough Service - Sua plataforma confiável para serviços de qualidade.</p>
            </div>

            <div class="footer-section">
                <h3>Contato</h3>
                <p>Email: contato@toughservice.com</p>
                <p>Telefone: (71) 1234-5678</p>
            </div>

            <div class="footer-section">
                <h3>Redes Sociais</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i><a href="https://www.instagram.com/tough_service?utm_source=ig_web_button_share_sheet&igsh=MW1hdjNwZHoyZ2NsMw=="></a></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>

            <div class="footer-section">
                <h3>Links Úteis</h3>
                <ul>
                    <li><a href="#">Termos de Uso</a></li>
                    <li><a href="#">Política de Privacidade</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
        </div>
    </footer>

    <!-- Bootstrap core JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS -->
    <script src="js/scripts.js"></script>
</body>
</html>
