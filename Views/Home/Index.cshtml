@model List<ProjetoThoughServiceMvc.Models.ProdutoModel>
@using ProjetoThoughServiceMvc.Models

@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
    
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Though Service</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Core theme CSS (includes Bootstrap) -->
    <link href="~/css/styles.css" rel="stylesheet" />
    
    <link href="~/css/Minimalista.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation Minimalista -->
    <nav class="navbar-minimal">
        <div class="nav-container">
            <!-- Logo -->
            <div class="nav-logo">
                <a asp-action="Index" asp-controller="Home" class="logo-link">
                    
                    <span class="logo-text">Tough Service</span>
                </a>
            </div>

            <!-- Busca Minimalista -->
            <div class="nav-search">
                <form asp-action="Buscar" asp-controller="Home" method="GET" class="search-form-minimal">
                    <div class="search-input-container">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" name="busca" placeholder="Buscar produtos..." class="search-input-minimal" />
                    </div>
                </form>
            </div>

            <!-- Menu Principal -->
            <div class="nav-menu">
                <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a asp-action="ADM" asp-controller="ADM" class="nav-link">Admin</a>
                }

                @if (!isLoggedIn)
                {
                    <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                    <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
                }
                else
                {
                    <a asp-action="Perfil" asp-controller="Perfil" class="nav-link">Perfil</a>
                }

               
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>
             
                <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
            </div>

            <!-- Carrinho -->
            <div class="nav-cart">
                @if (!isLoggedIn)
                {
                    <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                        <i class="fas fa-sign-in-alt"></i>
                        <span>Login</span>
                    </a>
                }
                else
                {
                    <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="cart-count">@quantidadeItensCarrinho</span>
                    </a>
                }
            </div>

            <!-- Menu Mobile -->
            <button class="mobile-menu-btn" type="button">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <!-- Hero Section Minimalista -->
    <header class="bg-dark py-5" height="300px">
        <div class="container px-4 px-lg-5 my-5">
            <div class="text-center text-white">
                <img src="IMG/LOGO (2).png" height="200px"  class="LogoThough" />
                <p class="lead fw-normal text-white-50 mb-0">EQUIPAMENTOS E ASSESSORIA DE SEGURANÇA LTDA</p>
                <div class="hero-features">
                    <span class="feature-badge">✓ Certificado ISO</span>
                    <span class="feature-badge">✓ Entrega Rápida</span>
                    <span class="feature-badge">✓ Suporte 24/7</span>
                </div>
            </div>
            </div>
        
    </header>


    <!-- Section: Produtos -->
    <!-- Produtos Minimalistas -->
    <section class="products-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Nossos Produtos</h2>
                <p class="section-subtitle">Equipamentos de segurança com qualidade certificada</p>
            </div>

            <div class="products-grid">
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var produto in Model)
                    {
                        <div class="product-card-minimal">
                            <div class="product-image">
                                <img src="@Url.Content("~/IMG/" + produto.ImagemUrl)" alt="@produto.Nome" />
                                <div class="product-overlay">
                                    <a asp-action="InfoProduto" asp-controller="Carrinho" asp-route-id="@produto.Id" class="view-btn">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                                    {
                                        <form asp-action="RemoverProduto" asp-controller="Home" method="post" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');" class="admin-form">
                                            <input type="hidden" name="id" value="@produto.Id" />
                                            <button type="submit" class="delete-btn">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                            <div class="product-info">
                                <h3 class="product-name">@produto.Nome</h3>
                                <div class="product-rating">
                                    <div class="stars">★★★★★</div>
                                </div>
                                <div class="product-price">R$ @produto.Preco.ToString("F2")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-products">
                        <i class="fas fa-box-open"></i>
                        <p>Nenhum produto disponível no momento.</p>
                    </div>
                }
            </div>
        </div>
    </section>


    <!-- Footer Minimalista -->
    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>

                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a asp-action="Sobre" asp-controller="Home">Sobre</a>
                        <a asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        <a href="#">Contato</a>
                    </div>

                    <div class="footer-column">
                        <h4>Suporte</h4>
                        <a href="#">FAQ</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>

                    <div class="footer-column">
                        <h4>Redes Sociais</h4>
                        <div class="social-links-minimal">
                            <a href="https://www.instagram.com/tough_service?utm_source=ig_web_button_share_sheet&igsh=MW1hdjNwZHoyZ2NsMw==" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" aria-label="Facebook">
                                <i class="fab fa-facebook"></i>
                            </a>
                            <a href="#" aria-label="LinkedIn">
                                <i class="fab fa-linkedin"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap core JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS -->
    <script src="js/scripts.js"></script>
    <!-- Minimal Interactive JS -->
    <script src="~/js/MinimalistaPrincipal.js"></script>
</body>
</html>
