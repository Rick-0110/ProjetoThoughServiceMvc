@{
    bool isLoggedIn = User.Identity.IsAuthenticated;
    var quantidadeItensCarrinho = Model?.Count ?? 0;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sobre - Tough Service</title>
    <link rel="stylesheet" href="~/css/Sobre.css">
    <link rel="stylesheet" href="~/css/Minimalista.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="IMG/LOGO (2).png">
</head>
<body>
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <!-- Logo -->
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">

                        <img src="~/IMG/LOGO (2).png" alt="" width="60vh">
                    </a>
                </div>


                <!-- Menu Principal -->
                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>



                    @if (!isLoggedIn)
                    {
                        <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                        <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                    }


                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>

                    <a asp-action="Sobre" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Sobre" ? "active" : "")">Sobre</a>
                </div>

                <!-- Carrinho -->
                <div class="nav-cart">
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Login</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">@quantidadeItensCarrinho</span>
                        </a>
                    }
                </div>

                <!-- Menu Mobile -->
                <button class="mobile-menu-btn" type="button">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>
    </header>
    </header>
    <main>
        <section class="sobre-container">
            <h1>Sobre a Tough Service</h1>

            <div><img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQbvhxWOxx4UfD_u768fLJcrAwnYL2o0tsNlw&s" alt="Alternate Text" /></div>
            <p>
                A Tough Service nasceu com o propósito de conectar pessoas e empresas a serviços de qualidade, com segurança, agilidade e confiança. Nossa plataforma oferece soluções inovadoras para facilitar o dia a dia de quem busca ou oferece serviços, promovendo o crescimento de profissionais e a satisfação de clientes.
            </p>
            <h2>Missão</h2>
            <p>
                Proporcionar experiências positivas, conectando clientes a profissionais qualificados, promovendo a excelência e a confiança em cada serviço realizado.
            </p>
            <h2>Visão</h2>
            <p>
                Ser referência nacional em intermediação de serviços, reconhecida pela inovação, qualidade e compromisso com nossos usuários.
            </p>
            <h2>Valores</h2>
            <ul>
                <li>Ética e transparência</li>
                <li>Compromisso com a qualidade</li>
                <li>Respeito ao cliente e ao profissional</li>
                <li>Inovação constante</li>
                <li>Responsabilidade social</li>
            </ul>
        </section>
    </main>
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>Contato</h3>
                <p>Email: contato@toughservice.com</p>
                <p>Telefone: (71) 99204-6022</p>
            </div>
            <div class="footer-section">
                <h3>Endereço</h3>
                <p>Rua, 123</p>
                <p>Camaçari - BA</p>
            </div>
        </div>
    </footer>
    <script src="JS/MinimalistaPrincipal.js"></script>
</body>
</html>
