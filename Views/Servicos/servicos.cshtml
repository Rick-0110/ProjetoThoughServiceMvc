
@model ProjetoThoughServiceMvc.Models.ApplicationUser
@using ProjetoThoughServiceMvc.Models;

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;
    
}
@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Though Service</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Core theme CSS (includes Bootstrap) -->
    <link href="~/css/servicos.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <!-- Logo -->
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">

                        <img src="~/IMG/LOGO (2).png" alt="" width="60vh">
                    </a>
                </div>

              
                <!-- Menu Principal -->
                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>

                    @if (usuarioEhAdmin)
                    {
                        <a asp-action="AdicionarProdutoADM" asp-controller="Home" class="nav-link">Admin</a>
                    }

                    @if (!isLoggedIn)
                    {
                        <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                        <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
                    }
                    else
                    {
                        <a asp-action="Perfil" asp-controller="Perfil" class="nav-link">Perfil</a>
                    }


                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>

                    <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
                </div>

                <!-- Carrinho -->
                <div class="nav-cart">
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Login</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">@quantidadeItensCarrinho</span>
                        </a>
                    }
                </div>

                <!-- Menu Mobile -->
                <button class="mobile-menu-btn" type="button">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>
    </header>

    <main>
        <section class="servicos-container">
            <h1>Nossos Serviços</h1>
            
            <div class="servicos-grid">
                <!-- Serviço 1 -->
                 <section>
                <div class="servico-card">
                    <div class="servico-icon">
                        <i class="fas fa-tools"></i>
                    </div>
                    <h3>Manutenção Preventiva</h3>
                    <p>Realizamos manutenção preventiva para garantir o melhor desempenho do seu equipamento.</p>
                    <ul class="servico-lista">
                        <li>Inspeção completa</li>
                        <li>Lubrificação</li>
                        <li>Ajustes necessários</li>
                        <li>Testes de funcionamento</li>
                    </ul>
                        @if (isLoggedIn)
                        {
                            <form asp-action="AgendamentoManutencaoRecarga" asp-controller="Servicos" method="get">
                                <button class="btn-servico" asp-action="AgendamentoManutencaoRecarga" asp-controller="Servicos">Solicitar Orçamento</button>
                            </form>
                        }
                        else
                        {
                          <form >
                            <button class="btn-servico" onclick="alert('Por favor, faça login para solicitar um orçamento.')"
                            asp-action="Login" asp-controller="Registro">Solicitar Orçamento</button>

                            </form>
                        }
                    </div>
            </section>
                <!-- Serviço 2 -->
                 <section>
                <div class="servico-card">
                    <div class="servico-icon">
                        <i class="fas fa-wrench"></i>
                    </div>
                    <h3>Reparo Técnico</h3>
                    <p>Equipe especializada em reparos técnicos de equipamentos industriais.</p>
                    <ul class="servico-lista">
                        <li>Diagnóstico preciso</li>
                        <li>Reparo de componentes</li>
                        <li>Substituição de peças</li>
                        <li>Garantia do serviço</li>
                    </ul>
                    <button class="btn-servico">Solicitar Orçamento</button>
                </div>
            </section>
                <!-- Serviço 3 -->
                 <section>
                <div class="servico-card">
                    <div class="servico-icon">
                        <i class="fas fa-cogs"></i>
                    </div>
                    <h3>Instalação</h3>
                    <p>Instalação profissional de equipamentos industriais.</p>
                    <ul class="servico-lista">
                        <li>Planejamento da instalação</li>
                        <li>Montagem profissional</li>
                        <li>Testes de segurança</li>
                        <li>Treinamento operacional</li>
                    </ul>
                    <button class="btn-servico">Solicitar Orçamento</button>
                </div>
            </section>
                <!-- Serviço 4 -->
                 <section>
                <div class="servico-card">
                    <div class="servico-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h3>Suporte Técnico</h3>
                    <p>Suporte técnico especializado para seus equipamentos.</p>
                    <ul class="servico-lista">
                        <li>Atendimento 24/7</li>
                        <li>Suporte remoto</li>
                        <li>Orientação técnica</li>
                        <li>Solução de problemas</li>
                    </ul>
                    <button class="btn-servico">Solicitar Orçamento</button>
                </div>
            </section>
            </div>
       

    </main>

    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>

                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a asp-action="Sobre" asp-controller="Home">Sobre</a>
                        <a asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        <a href="#">Contato</a>
                    </div>

                    <div class="footer-column">
                        <h4>Suporte</h4>
                        <a href="#">FAQ</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>

                    <div class="footer-column">
                        <h4>Redes Sociais</h4>
                        <div class="social-links-minimal">
                            <a href="#" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" aria-label="Facebook">
                                <i class="fab fa-facebook"></i>
                            </a>
                            <a href="#" aria-label="LinkedIn">
                                <i class="fab fa-linkedin"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>


    <script src="~/js/MinimalistaPrincipal.js"></script>
</body>
</html>