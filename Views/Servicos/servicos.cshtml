@using ToughService.Models

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    ViewData["Title"] = "Serviços";
    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");
}
@{
    bool isLoggedIn = User.Identity.IsAuthenticated;
    var session = HttpContextAccessor.HttpContext.Session;
    var carrinho = session.GetObject<List<ToughService.Models.ItemCarrinhoModel>>("Carrinho") ?? new List<ToughService.Models.ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
}


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Though Service - Serviços</title>
    <link rel="icon" type="image/x-icon" href="~/assets/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="~/css/servicos.css" rel="stylesheet" />


    @if (TempData["SucessoForm"] != null)
    {
        <meta name="show-success-modal" content="true" />
    }


</head>
<body>
   
    <main>
        <section class="servicos-container">
            <h1>Nossos Serviços</h1>


            @if (TempData["ErroForm"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["ErroForm"]</div>
            }

            <div class="servicos-grid">
                <section>
                    <div class="servico-card">
                        <div class="servico-icon"><i class="fas fa-tools"></i></div>
                        <h3>Manutenção Preventiva</h3>
                        <p>Garanta o melhor desempenho.</p>
                        <ul class="servico-lista"><li>Inspeção</li><li>Lubrificação</li><li>Ajustes</li><li>Testes</li></ul>
                        @if (isLoggedIn)
                        {
                            <button class="btn-servico" onclick="openModal('manutencao')">Solicitar Orçamento</button>
                        }
                        else
                        {
                            <a asp-action="Login" asp-controller="Registro" class="btn-servico">Faça o login</a>
                        }
                    </div>
                </section>
                <section>
                    <div class="servico-card">
                        <div class="servico-icon"><i class="fas fa-wrench"></i></div>
                        <h3>Reparo Técnico</h3>
                        <p>Equipe especializada.</p>
                        <ul class="servico-lista"><li>Diagnóstico</li><li>Reparo</li><li>Peças</li><li>Garantia</li></ul>
                        @if (isLoggedIn)
                        {
                            <button class="btn-servico" onclick="openModal('reparo')">Solicitar Orçamento</button>
                        }
                        else
                        {
                            <a asp-action="Login" asp-controller="Registro" class="btn-servico">Faça o login</a>
                        }
                    </div>
                </section>
                <section>
                    <div class="servico-card">
                        <div class="servico-icon"><i class="fas fa-cogs"></i></div>
                        <h3>Instalação</h3>
                        <p>Instalação profissional.</p>
                        <ul class="servico-lista"><li>Planejamento</li><li>Montagem</li><li>Testes</li><li>Treinamento</li></ul>
                        @if (isLoggedIn)
                        {
                            <button class="btn-servico" onclick="openModal('instalacao')">Solicitar Orçamento</button>
                        }
                        else
                        {
                            <a asp-action="Login" asp-controller="Registro" class="btn-servico">Faça o login</a>
                        }
                    </div>
                </section>
                <section>
                    <div class="servico-card">
                        <div class="servico-icon"><i class="fas fa-headset"></i></div>
                        <h3>Suporte Técnico</h3>
                        <p>Suporte especializado.</p>
                        <ul class="servico-lista"><li>Atendimento</li><li>Remoto</li><li>Orientação</li><li>Solução</li></ul>
                        @if (isLoggedIn)
                        {
                            <button class="btn-servico" onclick="openModal('suporte')">Solicitar Orçamento</button>
                        }
                        else
                        {
                            <a asp-action="Login" asp-controller="Registro" class="btn-servico">Faça o login</a>
                        }
                    </div>
                </section>
            </div>
        </section>
    </main>

    <div id="modalOrcamento" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Solicitar Orçamento</h2>
                <span class="close" onclick="closeModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="formOrcamento"
                      asp-controller="Chamados"
                      asp-action="SolicitarServico"
                      method="post">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="tipoServicoHidden" name="TipoServico" value="" />

                    <div class="form-group">
                        <label for="nomeCliente">Nome do Cliente *</label>
                        <input type="text" id="nomeCliente" name="NomeCliente" required>
                    </div>
                    <div class="form-group">
                        <label for="dataDesejada">Data Desejada *</label>
                        <input type="date" id="dataDesejada" name="DataDesejada" required>
                    </div>
                    <div class="form-group">
                        <label for="tipoExtintor">Tipo de Equipamento / Quantidade *</label>
                        <div class="extintor-container">
                            <select id="tipoExtintor" name="TipoExtintor" required>
                                <option value="">Selecione o tipo</option>
                                <option value="Extintor de Água (10L)">Extintor de Água (10L)</option>
                                <option value="Extintor PQS (4kg)">Extintor PQS (4kg)</option>
                                <option value="Extintor CO2 (5kg)">Extintor CO2 (5kg)</option>
                                <option value="Extintor de Espuma (6L)">Extintor de Espuma (6L)</option>
                                <option value="Sistema Fixo">Sistema Fixo</option>
                                <option value="Sistema de Sprinklers">Sistema de Sprinklers</option>
                                <option value="Sistema de Detecção">Sistema de Detecção</option>
                            </select>
                            <input type="number" id="quantidade" name="Quantidade" placeholder="Qtde" min="1" required style="width: 80px;">
                        </div>
                    </div>
                    <div class="form-group"><h4 style="margin-top: 20px;">Endereço</h4></div>
                    <div class="row">
                        <div class="col-md-3 form-group"><label for="cep">CEP *</label><input type="text" id="cep" name="Cep" required /></div>
                        <div class="col-md-6 form-group"><label for="logradouro">Rua/Avenida *</label><input type="text" id="logradouro" name="Logradouro" required /></div>
                        <div class="col-md-3 form-group"><label for="numero">Número *</label><input type="text" id="numero" name="Numero" required /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group"><label for="bairro">Bairro *</label><input type="text" id="bairro" name="Bairro" required /></div>
                        <div class="col-md-4 form-group"><label for="cidade">Cidade *</label><input type="text" id="cidade" name="Cidade" required /></div>
                        <div class="col-md-2 form-group"><label for="estado">UF *</label><input type="text" id="estado" name="Estado" maxlength="2" required /></div>
                        <div class="col-md-2 form-group"><label for="complemento">Compl.</label><input type="text" id="complemento" name="Complemento" /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group"><label for="telefone">Telefone/WhatsApp *</label><input type="tel" id="telefone" name="Telefone" required /></div>
                    </div>
                    <div class="form-group">
                        <label for="observacoes">Observações</label>
                        <textarea id="observacoes" name="Observacoes" rows="3"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-cancel" onclick="closeModal()">Cancelar</button>
                        <button type="submit" class="btn-submit">Enviar Solicitação</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="modalSucesso" class="modal">
        <div class="modal-content modal-sucesso">
            <div class="modal-header"><h2>Sucesso!</h2><span class="close" onclick="closeSuccessModal()">&times;</span></div>
            <div class="modal-body text-center">
                <div class="success-icon"><i class="fas fa-check-circle"></i></div>
                <h3>Solicitação Enviada!</h3>
                <p>Recebemos sua solicitação. Entraremos em contato em breve.</p>
                <p class="success-details"><strong>Prazo:</strong> até 24h<br><strong>Contato:</strong> (XX) XXXXX-XXXX</p>
                <button class="btn-submit" onclick="closeSuccessModal()">Fechar</button>
            </div>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Servicos.js" asp-append-version="true"></script>
    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/scripts.js"></script>
</body>
</html>