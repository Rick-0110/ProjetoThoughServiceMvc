@model List<ToughService.Models.Produtos.ProdutoBaseModel>

@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ToughService.Models.ItemCarrinhoModel>>("Carrinho") ?? new List<ToughService.Models.ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="icon" href="IMG/LOGO (2).png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agendamento de Manutenção/Recarga - ToughService</title>
    <link href="CSS/AgendamentoManutencaoRecarga.css" rel="stylesheet" />
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/AgendamentoManutencaoRecarga.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <!-- Logo -->
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">

                        <img src="~/IMG/LOGO (2).png" alt="" width="60vh">
                    </a>
                </div>


                <!-- Menu Principal -->
                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>



                    @if (!isLoggedIn)
                    {
                        <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                        <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                    }


                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>

                    <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
                </div>

                <!-- Carrinho -->
                <div class="nav-cart">
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Login</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">@quantidadeItensCarrinho</span>
                        </a>
                    }
                </div>

                <!-- Menu Mobile -->
                <button class="mobile-menu-btn" type="button">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>
    </header>

    <main class="agendamento-container">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="agendamento-card">
                        <div class="agendamento-header">
                            <h1><i class="fas fa-calendar-alt"></i> Agendamento de Manutenção/Recarga</h1>
                            <p>Agende sua manutenção preventiva ou recarga de extintores de forma rápida e fácil</p>
                        </div>

                        <form class="agendamento-form" id="agendamentoForm">
                            <!-- Tipo de Serviço -->
                            <div class="form-section">
                                <h3><i class="fas fa-tools"></i> Tipo de Serviço</h3>
                                <div class="servico-options">
                                    <div class="servico-option">
                                        <input type="radio" id="manutencao" name="tipoServico" value="manutencao" required>
                                        <label for="manutencao">
                                            <div class="servico-card">
                                                <i class="fas fa-wrench"></i>
                                                <h4>Manutenção Preventiva</h4>
                                                <p>Inspeção e manutenção completa dos extintores</p>
                                                <span class="preco">A partir de R$ 50,00</span>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="servico-option">
                                        <input type="radio" id="recarga" name="tipoServico" value="recarga" required>
                                        <label for="recarga">
                                            <div class="servico-card">
                                                <i class="fas fa-fire-extinguisher"></i>
                                                <h4>Recarga de Extintores</h4>
                                                <p>Recarga e teste de pressão dos extintores</p>
                                                <span class="preco">A partir de R$ 80,00</span>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-section">
                                <h3><i class="fas fa-fire-extinguisher"></i> Tipo de Extintor</h3>
                                <div class="form-group">
                                    <label for="tipoExtintor">Selecione o tipo de extintor *</label>
                                    <select id="tipoExtintor" name="tipoExtintor" required>
                                        <option value="">Selecione o tipo de extintor</option>
                                        <option value="agua">Água (Classe A)</option>
                                        <option value="espuma">Espuma (Classe A e B)</option>
                                        <option value="co2">CO₂ (Classe B e C)</option>
                                        <option value="po-quimico">Pó Químico ABC (Classe A, B e C)</option>
                                        <option value="po-quimico-bc">Pó Químico BC (Classe B e C)</option>
                                        <option value="halon">Halon (Classe A, B e C)</option>
                                        <option value="agua-pressurizada">Água Pressurizada</option>
                                        <option value="agua-gel">Água com Gel</option>
                                        <option value="nao-sei">Não sei o tipo</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="capacidade">Capacidade do Extintor (litros ou kg)</label>
                                    <input type="text" id="capacidade" name="capacidade" placeholder="Ex: 4kg, 6kg, 10L, etc.">
                                </div>
                            </div>


                            <!-- Informações do Cliente -->
                            <div class="form-section">
                                <h3><i class="fas fa-user"></i> Informações do Cliente</h3>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="nome">Nome Completo *</label>
                                            <input type="text" id="nome" name="nome" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="email">E-mail *</label>
                                            <input type="email" id="email" name="email" required>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="telefone">Telefone *</label>
                                            <input type="tel" id="telefone" name="telefone" required>
                                        </div>
                                    </div>
                                   
                                </div>
                            </div>

                            <!-- Data e Horário -->
                            <div class="form-section">
                                <h3><i class="fas fa-calendar-check"></i> Data e Horário</h3>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="data">Data Preferida *</label>
                                            <input type="date" id="data" name="data" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="horario">Horário Preferido *</label>
                                            <select id="horario" name="horario" required>
                                                <option value="">Selecione um horário</option>
                                                <option value="08:00">08:00</option>
                                                <option value="09:00">09:00</option>
                                                <option value="10:00">10:00</option>
                                                <option value="11:00">11:00</option>
                                                <option value="14:00">14:00</option>
                                                <option value="15:00">15:00</option>
                                                <option value="16:00">16:00</option>
                                                <option value="17:00">17:00</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Local -->
                            <div class="form-section">
                                <h3><i class="fas fa-map-marker-alt"></i> Local do Serviço</h3>
                                <div class="form-group">
                                    <label for="endereco">Endereço Completo *</label>
                                    <input type="text" id="endereco" name="endereco" placeholder="Rua, número, bairro, cidade, CEP" required>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="complemento">Complemento</label>
                                            <input type="text" id="complemento" name="complemento" placeholder="Apartamento, sala, etc.">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="referencia">Ponto de Referência</label>
                                            <input type="text" id="referencia" name="referencia" placeholder="Próximo ao...">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detalhes do Serviço -->
                            <div class="form-section">
                                <h3><i class="fas fa-info-circle"></i> Detalhes do Serviço</h3>
                                <div class="form-group">
                                    <label for="quantidade">Quantidade de Extintores</label>
                                    <input type="number" id="quantidade" name="quantidade" min="1" value="1">
                                </div>
                                <div class="form-group">
                                    <label for="observacoes">Observações Adicionais</label>
                                    <textarea id="observacoes" name="observacoes" rows="4" placeholder="Descreva qualquer informação adicional sobre o serviço..."></textarea>
                                </div>
                            </div>

                            <!-- Termos e Condições -->
                            <div class="form-section">
                                <div class="checkbox-group">
                                    <input type="checkbox" id="termos" name="termos" required>
                                    <label for="termos">
                                        Li e aceito os <a href="#" class="termos-link">termos e condições</a> do serviço *
                                    </label>
                                </div>
                            </div>

                            <!-- Botões -->
                            <div class="form-actions">
                                <button type="button" class="btn btn-secondary" onclick="limparFormulario()">
                                    <i class="fas fa-eraser"></i> Limpar
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-calendar-plus"></i> Agendar Serviço
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section">
                <h3>Sobre Nós</h3>
                <p>Tough Service - Sua plataforma confiável para serviços de qualidade.</p>
            </div>

            <div class="footer-section">
                <h3>Contato</h3>
                <p>Email: contato@toughservice.com</p>
                <p>Telefone: (71) 1234-5678</p>
            </div>

            <div class="footer-section">
                <h3>Redes Sociais</h3>
                <div class="social-links">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i><a href="https://www.instagram.com/tough_service?utm_source=ig_web_button_share_sheet&igsh=MW1hdjNwZHoyZ2NsMw=="></a></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>

            <div class="footer-section">
                <h3>Links Úteis</h3>
                <ul>
                    <li><a href="#">Termos de Uso</a></li>
                    <li><a href="#">Política de Privacidade</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="JS/agendamento.js"></script>
</body>
</html>
