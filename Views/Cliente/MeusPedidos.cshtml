@model List<ToughService.Models.ItemCarrinhoModel>
@using ToughService.Models
@using ToughService.Extensions

@{
    ViewData["Title"] = "Meus Pedidos";
    var pedidos = ViewBag.Pedidos as System.Collections.Generic.List<dynamic> ?? new System.Collections.Generic.List<dynamic>();
    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");
    var user = ViewBag.User as ToughService.Models.ApplicationUser;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="icon" href="~/IMG/LOGO (2).png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .btn-pagar-agora {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: #009ee3; 
            color: white !important;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            transition: background-color 0.2s;
        }
        .btn-pagar-agora:hover {
            background-color: #007eb5;
        }
    </style>
</head>
<body>
    <section class="pedidos-section">
        <div class="container">
            <div class="pedidos-header">
                <h1><i class="fas fa-receipt"></i> Meus Pedidos</h1>
                <p>Olá, @(user?.Nome?.Split(' ')[0] ?? "Cliente"). Acompanhe seus pedidos abaixo.</p>
            </div>

            @if (pedidos != null && pedidos.Count > 0)
            {
                <div class="pedidos-list">
                    @foreach (dynamic pedido in pedidos)
                    {
                        var item = (ItemCarrinhoModel)pedido.Item;
                        var pedidoId = pedido.PedidoId.ToString();
                        var data = (DateTime)pedido.Data;
                        var total = (decimal)pedido.Total;
                        var status = (string)pedido.Status;

                        // Verifica se existe o link de pagamento
                        string linkPagamento = null;
                        try { linkPagamento = pedido.LinkPagamento; } catch { }

                        var statusClass = status switch
                        {
                            "Entregue" => "status-entregue",
                            "Aprovado" => "status-entregue",
                            "Pago" => "status-entregue",
                            "Em Trânsito" => "status-transito",
                            "Pendente" => "status-pendente",
                            "Cancelado" => "status-cancelado",
                            _ => "status-pendente"
                        };

                        <div class="pedido-card">
                            <div class="pedido-header">
                                <div class="pedido-info">
                                    <h3 class="pedido-id">Pedido #@pedidoId</h3>
                                    <p class="pedido-date">
                                        <i class="fas fa-calendar"></i>
                                        Realizado em @data.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                                <span class="pedido-status @statusClass">
                                    @status
                                </span>
                            </div>

                            <div class="pedido-body">
                                @if (item != null)
                                {
                                    <div class="pedido-item">
                                        <div class="pedido-item-image">
                                            <img src="@Url.Content("~/IMG/Produtos/" + (item.Produto.ImagemUrl ?? "placeholder.png"))" alt="@item.Produto.Nome" />
                                        </div>
                                        <div class="pedido-item-details">
                                            <h4>@item.Produto.Nome</h4>
                                            @if (item.Quantidade > 1)
                                            {
                                                <p class="pedido-item-qty">Quantidade Total: <strong>@item.Quantidade itens</strong></p>
                                            }
                                            else
                                            {
                                                <p class="pedido-item-qty">Quantidade: <strong>1 item</strong></p>
                                            }
                                            <p class="pedido-item-price">Valor Unitário: R$ @item.Produto.Preco.ToString("N2", culturePtBr)</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="pedido-item">
                                        <p>Detalhes dos itens indisponíveis.</p>
                                    </div>
                                }

                                <div class="pedido-footer">
                                    <div class="pedido-total">
                                        <span class="total-label">Total do Pedido:</span>
                                        <span class="total-value">R$ @total.ToString("N2", culturePtBr)</span>
                                    </div>
                                    <div class="pedido-actions">

                                        @if (status == "Pendente" && !string.IsNullOrEmpty(linkPagamento))
                                        {
                                            <a href="@linkPagamento" class="btn-pagar-agora" target="_blank">
                                                <i class="fas fa-credit-card"></i> Pagar Agora
                                            </a>
                                        }
                                        else if (status == "Aprovado" || status == "Pago")
                                        {
                                            <a href="#" class="btn-action">
                                                <i class="fas fa-download"></i> Nota Fiscal
                                            </a>
                                        }

                                        

                                        @if (status == "Em Trânsito")
                                        {
                                            <a href="#" class="btn-action">
                                                <i class="fas fa-truck"></i> Rastrear
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pedidos-empty">
                    <div class="empty-icon">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <h3>Nenhum pedido encontrado</h3>
                    <p>Você ainda não realizou nenhum pedido. Comece a comprar agora!</p>
                    <a asp-action="Index" asp-controller="Home" class="btn-continuar-comprando">
                        <i class="fas fa-shopping-bag"></i> Continuar Comprando
                    </a>
                </div>
            }
        </div>
    </section>

    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/scripts.js"></script>
</body>
</html>