@{
    ViewData["Title"] = "Conta Bloqueada";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="text-danger">Acesso Bloqueado</h1>
            <h2 class="text-muted">
                Esta conta foi bloqueada devido a várias tentativas falhas de login.
            </h2>
            <p class="mt-4">
                Por favor, tente novamente mais tarde. Se o problema persistir, entre em contato com o suporte.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Voltar para a Home</a>
        </div>
    </div>
</div>