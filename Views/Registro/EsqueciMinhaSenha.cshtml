@{
    Layout = null;
    bool emailEnviado = ViewData["EmailEnviado"] != null && (bool)ViewData["EmailEnviado"];
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Esqueci minha senha - Tough Service</title>
    <link rel="stylesheet" href="~/css/EsqueciMinhaSenha.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="voltarPG">
        <a asp-action="Login" asp-controller="Registro"><i class="fas fa-arrow-left"></i></a>
    </div>
    <div class="conteiner">
        <div class="caixa-login">
            <div class="logo">
                <img src="~/IMG/LOGO (2).png" alt="Tough Service Logo">
            </div>

            @if (!emailEnviado)
            {
                <h2>Esqueci minha senha</h2>
                <p class="descricao">Digite seu email para receber instruções de recuperação de senha</p>

                <form asp-action="EsqueciMinhaSenha" asp-controller="Registro" method="post" class="login-form">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="grupo-entrada">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="Email" required>
                    </div>

                    <button type="submit" class="botao-entrar">
                        <i class="fas fa-paper-plane"></i>
                        Enviar instruções
                    </button>

                    <div class="links">
                        <a asp-action="Login" asp-controller="Registro">Voltar ao login</a>
                        <a asp-action="Registro" asp-controller="Registro">Criar conta</a>
                    </div>
                </form>
            }
            else
            {
                <div class="mensagem-sucesso" id="mensagemSucesso" style="display: block;">
                    <div class="icone-sucesso">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3>Email enviado!</h3>
                    <p>Se este email estiver cadastrado, você receberá as instruções em instantes.</p>
                    <a class="botao-voltar" asp-action="Login" asp-controller="Registro" style="display:inline-block; text-decoration:none; text-align:center;">
                        <i class="fas fa-arrow-left"></i> Voltar ao login
                    </a>
                </div>
            }
        </div>
    </div>
</body>
</html>