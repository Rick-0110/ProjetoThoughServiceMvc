@using ToughService.Models.LoginModels
@{
    Layout = null;
}

@model LoginModel

@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    var usuarioLogado = User.Identity.Name ?? "";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Tough Service</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="icon" href="~/IMG/LOGO (2).png" />

    <style>
        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 5px;
            border: 1px solid #f5c6cb;
            text-align: center;
            font-size: 0.9rem;
        }
        .validation-summary-errors ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="voltarPG">
        <a asp-action="Index" asp-controller="Home"><i class="fas fa-arrow-left"></i></a>
    </div>

    @if (!isLoggedIn)
    {
        <div class="conteiner">
            <div class="caixa-login">
                <div class="logo">
                    <img src="~/IMG/LOGO (2).png" alt="Tough Service Logo" />
                </div>
                <h2>Bem-vindo!</h2>

                @if (TempData["Mensagem"] != null)
                {
                    <div class="alert alert-success">@TempData["Mensagem"]</div>
                }

                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-action="Login" asp-controller="Registro" method="post">
                    <div class="grupo-entrada">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="grupo-entrada campo-senha-container">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Senha" type="password" id="senhaInput" placeholder="Senha" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                        <i class="fas fa-eye-slash toggle-senha" id="toggleSenha"></i>
                    </div>
                    <button type="submit" class="botao-entrar">
                        <i class="fas fa-sign-in-alt"></i>
                        Entrar
                    </button>
                    <div class="links">
                        <a asp-action="EsqueciMinhaSenha" asp-controller="Registro">Esqueceu a senha?</a>
                        <a asp-action="Registro" asp-controller="Registro">Criar conta</a>
                    </div>
                </form>

                <div class="separador">
                    <hr />
                    <span>ou entre com</span>
                    <hr />
                </div>

                <form asp-action="ExternalLogin" asp-controller="Registro" method="post" class="form-externo">
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="botao-google">
                        <i class="fab fa-google"></i>
                        Entrar com Google
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="conteiner">
            <h3>Opa, @usuarioLogado! Você já está logado.</h3>
            <a asp-controller="Perfil" asp-action="Perfil" asp-area="">Ir para Perfil</a>
            <form asp-controller="Registro" asp-action="Logout" method="post" style="margin-top:10px;">
                <button type="submit" class="btn btn-danger">Sair</button>
            </form>
        </div>
    }

    <script src="~/js/login.js"></script>
</body>
</html>