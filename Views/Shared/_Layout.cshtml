@using ToughService.Extensions
@using ToughService.Models
@{
    bool isLoggedIn = User.Identity.IsAuthenticated;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
   
    <title>@ViewData["Title"] - Tough Service</title>
    <link rel="icon" href="~/IMG/LOGO (2).png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link href="~/css/carrinho.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">

                        <span class="logo-text">Tough Service</span>
                    </a>
                </div>

                <div class="nav-search">
                    <form asp-action="Buscar" asp-controller="Home" method="GET" class="search-form-minimal">
                        <div class="search-input-container">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" name="busca" placeholder="Buscar produtos..." class="search-input-minimal" />
                        </div>
                    </form>
                </div>

                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>

                    @if (isLoggedIn && User.IsInRole("Admin"))
                    {
                        <a asp-action="ADM" asp-controller="ADM" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ADM" ? "active" : "")">Admin</a>
                    }
                   
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                    <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
                </div>

                <div class="nav-actions">
                    <div class="nav-cart">
                        @if (!isLoggedIn)
                        {
                            <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Login</span>
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                                <i class="fas fa-shopping-cart"></i>

                                @await Component.InvokeAsync("CarrinhoResumo")

                            </a>
                        }
                    </div>

                    @if (isLoggedIn)
                    {
                        <div class="profile-dropdown">
                            <button class="profile-btn" onclick="toggleProfileDropdown()">
                                <i class="fas fa-user-circle profile-icon"></i>
                            </button>
                            <div id="profileDropdownMenu" class="dropdown-menu">
                                <div class="dropdown-header">
                                    Olá, @User.Identity.Name!
                                </div>
                                <a class="dropdown-item" asp-action="MeusPedidos" asp-controller="Cliente">
                                    <i class="fas fa-clipboard-list"></i> Meus Pedidos
                                </a>
                                <a class="dropdown-item" asp-action="MeusServicos" asp-controller="Cliente">
                                    <i class="fas fa-briefcase"></i> Meus Serviços
                                </a>
                                <a class="dropdown-item" asp-action="Perfil" asp-controller="Perfil">
                                    <i class="fas fa-user"></i> Perfil
                                </a>
                                <a class="dropdown-item" asp-action="Configuracoes" asp-controller="Cliente">
                                    <i class="fas fa-cog"></i> Configurações
                                </a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Registro" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item logout-item">
                                        <i class="fas fa-sign-out-alt"></i> Sair
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <button class="mobile-menu-btn" type="button">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>
    </header>


    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>
                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a asp-action="Sobre" asp-controller="Home">Sobre</a>
                        <a asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        <a href="#">Contato</a>
                    </div>
                    <div class="footer-column">
                        <h4>Suporte</h4>
                        <a href="#">FAQ</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>
                    <div class="footer-column">
                        <h4>Redes Sociais</h4>
                        <div class="social-links-minimal">
                            <a href="https..."><i class="fab fa-instagram"></i></a>
                            <a href="#"><i class="fab fa-facebook"></i></a>
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="~/js/MeusServicos.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>