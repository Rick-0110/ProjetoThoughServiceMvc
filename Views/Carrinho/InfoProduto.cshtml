
@model ToughService.Models.ProdutoDetalheViewModel
@using ToughService.Extensions
@using ToughService.Models


@{
    bool isLoggedIn = User.Identity.IsAuthenticated;

}
@{
    var carrinho = Context.Session.GetObject<List<ItemCarrinhoModel>>("Carrinho") ?? new List<ItemCarrinhoModel>();
    int quantidadeItensCarrinho = carrinho.Sum(i => i.Quantidade);
    bool usuarioEhAdmin = ViewBag.UsuarioEhAdmin ?? false;
}


<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <meta name="description" content="" />
        <meta name="author" content="" />
        <title>Informações do produto - Though Service</title>
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
        <!-- Bootstrap icons-->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
        <!-- Core theme CSS (includes Bootstrap)-->
        <link href="~/css/styles.css" rel="stylesheet" />
         <link href="~/css/Minimalista.css" rel="stylesheet" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    </head>
    <body>
        @if (TempData["SucessoCarrinho"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 0; border-radius: 0; position: fixed; top: 0; left: 0; right: 0; z-index: 9999;">
                <strong>Sucesso!</strong> @TempData["SucessoCarrinho"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErroCarrinho"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin: 0; border-radius: 0; position: fixed; top: 0; left: 0; right: 0; z-index: 9999;">
                <strong>Erro!</strong> @TempData["ErroCarrinho"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    <!-- Navigation-->
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">
                        <img src="~/IMG/LOGO (2).png" alt="Tough Service Logo" width="60vh">
                    </a>
                </div>
                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">Home</a>
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Registro" asp-controller="Registro" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Registro" ? "active" : "")">Registro</a>
                        <a asp-action="Login" asp-controller="Registro" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Login" ? "active" : "")">Login</a>
                    }
                    else
                    {
                        <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                    }
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                    <a asp-action="Sobre" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Sobre" ? "active" : "")">Sobre</a>
                </div>
                <div class="nav-cart">
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Login" asp-controller="Registro" class="cart-btn"><i class="fas fa-sign-in-alt"></i><span>Login</span></a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Carrinho" class="cart-btn @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Carrinho" ? "active" : "")">
                            <i class="fas fa-shopping-cart"></i><span class="cart-count">@quantidadeItensCarrinho</span>
                        </a>
                    }
                </div>
                <button class="mobile-menu-btn" type="button" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
            </div>
        </nav>
    </header>
        <!-- Product section-->
        <section class="py-5">
       

<div class="container px-4 px-lg-5 my-5">
    <div class="row gx-4 gx-lg-5 align-items-center">
        <div class="col-md-6">
            <img class="card-img-top mb-5 mb-md-0" src="@Url.Content($"~/IMG/{Model.Produto.ImagemUrl}")" alt="Imagem do produto" />
        </div>
        <div class="col-md-6">
            <h1 class="display-5 fw-bolder">@Model.Produto.Nome</h1>
            <div class="fs-5 mb-5">
                <span>R$@Model.Produto.Preco.ToString("F2")</span>
            </div>
            <p class="lead">@Model.Produto.Descricao</p>

                    <form asp-controller="Carrinho" asp-action="AdicionarAoCarrinho" method="post">

                        @Html.AntiForgeryToken()
                   
                        <input type="hidden" name="produtoId" value="@Model.Produto.Id" />

                        <label for="quantidade">Quantidade:</label>
                        <input class="form-control mb-3" name="quantidade" type="number" value="1" min="1" style="max-width: 100px;" />

                        @if (isLoggedIn)
                        {
                            <button type="submit" class="btn btn-outline-dark">
                                <i class="bi-cart-fill me-1"></i>
                                Adicionar ao Carrinho
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Registro" asp-action="Login" class="btn btn-outline-dark">
                                <i class="bi-cart-fill me-1"></i>
                                Faça login para adicionar ao Carrinho
                            </a>
                        }
                    </form>

        </div>
    </div>
</div>
</section>
    <!-- Related items section-->
    <section class="py-5 bg-light">
        <div class="container px-4 px-lg-5 mt-5">
            <h2 class="fw-bolder mb-4">Outros produtos</h2>
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                @foreach (var produto in Model.OutrosProdutos)
                {
                    <div class="col mb-5">
                        <div class="card h-100">
                            <!-- Imagem -->
                            <img class="card-img-top" src="@Url.Content($"~/IMG/{produto.ImagemUrl}")" alt="@produto.Nome" />

                            <!-- Detalhes -->
                            <div class="card-body p-4 text-center">
                                <h5 class="fw-bolder">@produto.Nome</h5>
                                <span>R$@produto.Preco.ToString("F2")</span>
                            </div>

                            <!-- Botão visualizar -->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent text-center">
                                <a class="btn btn-outline-dark mt-auto"
                                   asp-controller="Carrinho"
                                   asp-action="InfoProduto"
                                   asp-route-id="@produto.Id">
                                    Visualizar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

        <!-- Footer-->
        <footer class="py-5 bg-dark">
            <div class="container"><p class="m-0 text-center text-white">Though</p></div>
        </footer>
        <!-- Bootstrap core JS-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Core theme JS-->
        <script src="js/scripts.js"></script>
    <script src="~/js/MinimalistaPrincipal.js"></script>
    </body>
</html>
