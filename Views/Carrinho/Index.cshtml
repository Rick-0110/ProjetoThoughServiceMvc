@model List<ToughService.Models.ItemCarrinhoModel>

@{
    ViewData["Title"] = "Carrinho de Compras";
    var quantidadeItensCarrinho = Model?.Sum(i => i.Quantidade) ?? 0;
    bool isLoggedIn = User.Identity.IsAuthenticated;
    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");

    // CORREÇÃO: O preço está em item.Produto.Preco
    // Adicionei uma verificação 'item.Produto != null' para segurança
    var subtotal = (Model != null && Model.Any()) ? Model.Sum(i => (i.Produto != null ? i.Produto.Preco : 0) * i.Quantidade) : 0m;
    var frete = 0m;
    var total = subtotal + frete;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="icon" href="~/IMG/LOGO (2).png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/carrinho.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar-minimal">
            <div class="nav-container">
                <div class="nav-logo">
                    <a asp-action="Index" asp-controller="Home" class="logo-link">
                        <img src="~/IMG/LOGO (2).png" alt="" width="60vh">
                    </a>
                </div>
                <div class="nav-menu">
                    <a asp-action="Index" asp-controller="Home" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">Home</a>
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Registro" asp-controller="Registro" class="nav-link">Registro</a>
                        <a asp-action="Login" asp-controller="Registro" class="nav-link">Login</a>
                    }
                    else
                    {
                        @* CORRIGIDO: O Perfil fica no PerfilController *@
                        <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                    }
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                       asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                    <a asp-action="Sobre" asp-controller="Home" class="nav-link">Sobre</a>
                </div>
                <div class="nav-cart">
                    @if (!isLoggedIn)
                    {
                        <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Login</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count">@quantidadeItensCarrinho</span>
                        </a>
                    }
                </div>
                <button class="mobile-menu-btn" type="button">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>
    </header>

    <section class="carrinho-main">
        <div class="carrinho-header">
            <h1><i class="fas fa-shopping-cart"></i> Meu Carrinho</h1>
            <p>Revise seus produtos antes de finalizar a compra</p>
        </div>

        @* Bloco para ver erros *@
        @if (TempData["SucessoCarrinho"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["SucessoCarrinho"]
            </div>
        }
        @if (TempData["ErroCarrinho"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErroCarrinho"]
            </div>
        }

        <div class="carrinho-layout">
            <div class="carrinho-items-section">
                <div class="carrinho-items-header">
                    <h2 class="carrinho-items-title">Produtos</h2>
                    @* CORREÇÃO: Usar Model.Count para contar os itens distintos *@
                    <span class="carrinho-items-count">@Model.Count() itens</span>
                </div>

                <div class="carrinho-items">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            @* Verificação de segurança para o caso de o produto ter sido apagado *@
                            if (item.Produto != null)
                            {
                                <div class="carrinho-item">
                                    <div class="carrinho-item-image">
                                        @* CORREÇÃO: Usar item.Produto.ImagemUrl *@
                                        <img src="@Url.Content("~/IMG/" + item.Produto.ImagemUrl)" alt="@item.Produto.Nome" class="img-produto" />
                                        <div class="quantity-badge">@item.Quantidade</div>
                                    </div>

                                    <div class="carrinho-item-info">
                                        <div class="item-details">
                                            @* CORREÇÃO: Usar item.Produto.Nome *@
                                            <h3 class="carrinho-item-name">@item.Produto.Nome</h3>
                                            @* CORREÇÃO: Usar item.Produto.Categoria *@
                                            <p class="carrinho-item-category">@item.Produto.Categoria.ToString()</p>
                                            <span class="quantity-label">Quantidade: <strong>@item.Quantidade</strong></span>
                                        </div>
                                        <div class="carrinho-item-prices">
                                            @* CORREÇÃO: Usar item.Produto.Preco *@
                                            <p class="unit-price">R$ @(item.Produto.Preco.ToString("N2", culturePtBr)) cada</p>
                                            <p class="total-price">R$ @((item.Produto.Preco * item.Quantidade).ToString("N2", culturePtBr))</p>
                                        </div>

                                        @* ADICIONADO: Formulário de Remoção para cada item *@
                                        <form asp-action="RemoverDoCarrinho" asp-controller="Carrinho" method="post" class="remove-form">
                                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-remove-item" title="Remover item"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="carrinho-vazio">
                            <div class="carrinho-vazio-icon"><i class="fas fa-shopping-cart"></i></div>
                            <h3>Seu carrinho está vazio</h3>
                            <p>Adicione produtos para começar sua compra</p>
                            <a class="btn btn-primary" asp-action="Index" asp-controller="Home">Continuar Comprando</a>
                        </div>
                    }
                </div>
            </div>

            <div class="carrinho-resumo">
                <h2 class="carrinho-resumo-title">Resumo do Pedido</h2>
                <div class="resumo-item">
                    <span class="resumo-label">Subtotal (@quantidadeItensCarrinho itens)</span>
                    <span class="resumo-value">R$ @subtotal.ToString("N2", culturePtBr)</span>
                </div>
                <div class="resumo-item">
                    <span class="resumo-label">Frete</span>
                    <span class="resumo-value">R$ @frete.ToString("N2", culturePtBr)</span>
                </div>
                <div class="resumo-total">
                    <span class="resumo-total-label">Total</span>
                    <span class="resumo-total-value">R$ @total.ToString("N2", culturePtBr)</span>
                </div>
                <div class="carrinho-actions">
                    <a class="btn-continuar" asp-action="Index" asp-controller="Home">
                        <i class="fas fa-arrow-left me-2"></i> Continuar Comprando
                    </a>
                    <a class="btn-finalizar" href="#">
                        <i class="fas fa-credit-card me-2"></i> Finalizar Compra
                    </a>
                    <form asp-action="ClearCarrinho" asp-controller="Carrinho" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-limpar">
                            <i class="fas fa-trash me-2"></i> Limpar Carrinho
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    @* (O seu footer continua aqui...) *@
    <footer class="footer-minimal">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>Tough Service</h3>
                    <p>Equipamentos e assessoria de segurança</p>
                </div>
                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Empresa</h4>
                        <a asp-action="Sobre" asp-controller="Home">Sobre</a>
                        <a asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        <a href="#">Contato</a>
                    </div>
                    <div class="footer-column">
                        <h4>Suporte</h4>
                        <a href="#">FAQ</a>
                        <a href="#">Política de Privacidade</a>
                        <a href="#">Termos de Uso</a>
                    </div>
                    <div class="footer-column">
                        <h4>Redes Sociais</h4>
                        <div class="social-links-minimal">
                            <a href="https://www.instagram.com/tough_service?utm_source=ig_web_button_share_sheet&igsh=MW1hdjNwZHoyZ2NsMw==" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 Tough Service. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/MinimalistaPrincipal.js"></script>
</body>
</html>