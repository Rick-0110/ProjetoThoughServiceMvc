@model List<ToughService.Models.ItemCarrinhoModel>



@{
    ViewData["Title"] = "Carrinho de Compras";
    var quantidadeItensCarrinho = Model?.Count ?? 0;

    bool isLoggedIn = User.Identity.IsAuthenticated;

    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");

    var subtotal = (Model?.Sum(i => (i.Produto.Preco / 1m) * i.Quantidade)) ?? 0m;
    var frete = 0m;
    var total = subtotal + frete;
}


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="icon" href="~/IMG/LOGO (2).png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/carrinho.css" />
    <link rel="stylesheet" href="~/css/Minimalista.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <section class="carrinho-main">
        <div class="carrinho-header">
            <h1><i class="fas fa-shopping-cart"></i> Meu Carrinho</h1>
            <p>Revise seus produtos antes de finalizar a compra</p>
        </div>

        <div class="carrinho-layout">
            <div class="carrinho-items-section">
                <div class="carrinho-items-header">
                    <div class="select-all-wrapper">
                        <input type="checkbox" id="selectAll" checked />
                        <label for="selectAll">Produtos</label>
                    </div>
                    <span class="carrinho-items-count">@quantidadeItensCarrinho itens</span>
                </div>

                <div class="carrinho-items">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="carrinho-item">
                                <div class="carrinho-item-select">
                                    <input type="checkbox"
                                           class="cart-select-item"
                                           value="@item.ProdutoId"
                                           checked />
                                </div>
                                <div class="carrinho-item-image">
                                    <img src="@Url.Content("~/IMG/" + item.Produto.ImagemUrl)" alt="@item.Produto.Nome" class="img-produto" />
                                    <div class="quantity-badge">@item.Quantidade</div>
                                </div>

                                <div class="carrinho-item-info">
                                    <div class="item-details">
                                        <h3 class="carrinho-item-name">@item.Produto.Nome</h3>
                                        <p class="carrinho-item-category">Equipamento de Segurança</p>

                                        <div class="quantity-controls">
                                            <form asp-action="AlterarQuantidade" asp-controller="Carrinho" method="post" class="quantity-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="produtoId" value="@item.ProdutoId" />

                                                <button type="submit" name="delta" value="-1" class="btn-qty btn-qty-minus" title="Diminuir quantidade">
                                                    <i class="fas fa-minus"></i>
                                                </button>

                                                <span class="quantity-label">
                                                    Quantidade: <strong>@item.Quantidade</strong>
                                                </span>

                                                <button type="submit" name="delta" value="1" class="btn-qty btn-qty-plus" title="Aumentar quantidade">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <form asp-action="ManterSomenteProduto" asp-controller="Carrinho" method="post" class="keep-only-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                                            <label class="keep-only-checkbox">
                                                <input type="checkbox" onchange="this.form.submit()" @(Model.Count > 1 ? "" : "disabled checked") />
                                                <span>Continuar comprando apenas este produto</span>
                                            </label>
                                        </form>
                                    </div>

                                    <div class="carrinho-item-prices">
                                        <p class="unit-price">R$ @(item.Produto.Preco.ToString("N2", culturePtBr)) cada</p>
                                        <p class="total-price">R$ @((item.Produto.Preco * item.Quantidade).ToString("N2", culturePtBr))</p>
                                    </div>
                                    <form asp-action="RemoverDoCarrinho" asp-controller="Carrinho" method="post" class="remove-form">

                                        <input type="hidden" name="produtoId" value="@item.ProdutoId" />

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn-remove-item" title="Remover item">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>

                            </div>


                        }
                    }
                    else
                    {
                        <div class="carrinho-vazio">
                            <div class="carrinho-vazio-icon">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                            <h3>Seu carrinho está vazio</h3>
                            <p>Adicione produtos para começar sua compra</p>
                            <a class="btn btn-primary" asp-action="Index" asp-controller="Home">Continuar Comprando</a>
                        </div>
                    }
                </div>
            </div>

            <div class="carrinho-resumo">
                <h2 class="carrinho-resumo-title">Resumo do Pedido</h2>

                <div class="resumo-item">
                    <span class="resumo-label">Subtotal (@quantidadeItensCarrinho itens)</span>
                    <span class="resumo-value">R$ @subtotal.ToString("N2", culturePtBr)</span>
                </div>

                <div class="resumo-item">
                    <span class="resumo-label">Frete</span>
                    <span class="resumo-value">R$ @frete.ToString("N2", culturePtBr)</span>
                </div>

                <div class="resumo-total">
                    <span class="resumo-total-label">Total</span>
                    <span class="resumo-total-value">R$ @total.ToString("N2", culturePtBr)</span>
                </div>

                <div class="carrinho-actions">
                    <a class="btn-continuar" asp-action="Index" asp-controller="Home">
                        <i class="fas fa-arrow-left me-2"></i>
                        Continuar Comprando
                    </a>
                    <form asp-action="CheckoutSelecionado" asp-controller="Carrinho" method="post" class="form-finalizar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="selectedProdutoIdsField" name="selectedProdutoIds" />
                        <button type="submit" class="btn-finalizar">
                            <i class="fas fa-credit-card me-2"></i>
                            Finalizar Compra
                        </button>
                    </form>
                    <form asp-action="ClearCarrinho" method="post">
                        <button type="submit" class="btn-limpar">
                            <i class="fas fa-trash me-2"></i>
                            Limpar Carrinho
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

 
 

    <script src="~/js/MinimalistaPrincipal.js"></script>
    <script src="~/js/carrinho.js"></script>
    <script src="~/js/scripts.js"></script>
</body>

</html>
