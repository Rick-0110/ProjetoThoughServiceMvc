
@model List<ProjetoThoughServiceMvc.Models.ItemCarrinhoModel>



@{
    ViewData["Title"] = "Carrinho de Compras";
    var quantidadeItensCarrinho = Model?.Count ?? 0;

   bool isLoggedIn = User.Identity.IsAuthenticated;

    var culturePtBr = new System.Globalization.CultureInfo("pt-BR");

    var subtotal = (Model?.Sum(i => (i.Preco / 1m) * i.Quantidade)) ?? 0m;
    var frete = 0m;
    var total = subtotal + frete;
}


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="icon" href="~/IMG/LOGO (2).png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
  
    <link href="~/css/Minimalista.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/carrinho.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container px-4 px-lg-5">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li><img src="~/IMG/LOGO (2).png" alt="" width="40px"></li>


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-action="Index" asp-controller="Home">Home</a>
                        </li>
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-action="Registro" asp-controller="Registro">Registro</a></li>
                            <li class="nav-item"><a class="nav-link" asp-action="Login" asp-controller="Registro">Login</a></li>
                        }
                        else
                        {
                            <a asp-action="Perfil" asp-controller="Perfil" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfil" ? "active" : "")">Perfil</a>
                        }


                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Servicos" ? "active" : "")"
                               asp-action="Servicos" asp-controller="Servicos">Serviços</a>
                        </li>
                        <li class="nav-item dropdown">

                        </li>
                    </ul>
                    <div class="nav-cart">
                        @if (!isLoggedIn)
                        {


                            <a asp-action="Login" asp-controller="Registro" class="cart-btn">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Carrinho</span>
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-controller="Carrinho" class="cart-btn">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-count">@quantidadeItensCarrinho</span>
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

 

    <section>
        <div class="carrinho-items">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="carrinho-item">
                        <div class="info-produto">
                            <div class="imagem-produto">
                                <img src="@Url.Content("~/IMG/" + item.ImagemUrl)" alt="@item.NomeProduto"class="img-produto" style="max-width:300px;max-height:300px;" />

                            </div>
                            <h3>@item.NomeProduto</h3>
                            <p class="preco">
                                Preço unitário: <strong>R$ @(item.Preco.ToString("N2", culturePtBr))</strong>
                            </p>
                        </div>
                        <div class="info-quantidade">
                            <p>Qtd: <strong>@item.Quantidade</strong></p>
                            <p>
                                Total:
                                <strong>
                                   R$ @((item.Preco * item.Quantidade).ToString("N2", culturePtBr))
                                </strong>
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="vazio">O carrinho está vazio.</p>
            }
        </div>

        <div class="carrinho-resumo">
            <div class="resumo-item">
                <span>Subtotal:</span>
                <span class="subtotal">R$ @subtotal.ToString("N2", culturePtBr)</span>
            </div>
            <div class="resumo-item">
                <span>Frete:</span>
                <span class="frete">R$ @frete.ToString("N2", culturePtBr)</span>
            </div>
            <div class="resumo-total">
                <span>Total:</span>
                <span class="total">R$ @total.ToString("N2", culturePtBr)</span>
            </div>


            <div class="carrinho-actions">
                <a class="btn-continuar" asp-action="Index" asp-controller="Home">Continuar compra</a>
                <form asp-action="Limpar" method="post">
                    <button type="submit" class="btn-limpar">Limpar Carrinho</button>
                </form>
            </div>
        </div>
    </section>

    <footer>
        <div class="footer-section">
            <h3>Contato</h3>
            <p>Email: contato@toughservice.com</p>
            <p>Telefone: (71) xxxx-xxxx</p>
        </div>
    </footer>
</body>
</html>
