@model ToughService.Models.ModelCheckout.CheckoutViewModel
@using System.Globalization
@using System.Linq
@{
    ViewData["Title"] = "Finalizar Compra";
    var culture = new CultureInfo("pt-BR");

    var selectedPayment = string.IsNullOrWhiteSpace(Model?.PaymentMethod) ? "card" : Model.PaymentMethod;
    var selectedShippingMethod = string.IsNullOrWhiteSpace(Model?.ShippingMethod) ? string.Empty : Model.ShippingMethod;
    var isQualifiedForDelivery = Model?.TotalExtintores >= 5;
    var shippingOptions = Model?.ShippingOptions ?? Enumerable.Empty<ToughService.Models.ModelCheckout.CheckoutShippingOptionViewModel>();

    if (!isQualifiedForDelivery)
    {
        shippingOptions = shippingOptions.Where(o => o.Value.Equals("pickup", StringComparison.OrdinalIgnoreCase));
        if (selectedShippingMethod.Equals("delivery", StringComparison.OrdinalIgnoreCase))
        {
            selectedShippingMethod = "pickup";
        }
    }

    var selectedShippingOption = shippingOptions.FirstOrDefault(o => o.Value.Equals(selectedShippingMethod, StringComparison.OrdinalIgnoreCase));
    selectedShippingOption ??= shippingOptions.FirstOrDefault(o => o.IsDefault) ?? shippingOptions.FirstOrDefault();
    selectedShippingMethod = selectedShippingOption?.Value ?? selectedShippingMethod;

    var shippingSummaryText = selectedShippingOption == null
        ? "Calcule o frete"
        : $"{selectedShippingOption.Title} · {(selectedShippingOption.Price <= 0 ? "Grátis" : selectedShippingOption.Price.ToString("C", culture))}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <style>
  
        .payment-info-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin-top: 15px;
            color: #495057;
        }

            .payment-info-box i {
                font-size: 2rem;
                margin-bottom: 10px;
                color: #009ee3; 
                display: block;
            }

            .payment-info-box strong {
                display: block;
                margin-bottom: 5px;
                font-size: 1.1rem;
            }
    </style>
}

<div class="checkout-page" data-page="checkout">
    <header class="checkout-header">
        <div class="checkout-badge">
            <span class="badge-step is-active" data-step="1">Carrinho</span>
            <span class="badge-divider"></span>
            <span class="badge-step is-active" data-step="2">Dados</span>
            <span class="badge-divider"></span>
            <span class="badge-step is-active" data-step="3">Pagamento</span>
            <span class="badge-divider"></span>
            <span class="badge-step" data-step="4">Confirmação</span>
        </div>
        <div class="checkout-title">
            <h1>Finalize a sua compra</h1>
            <p>Revise seus dados e escolha a forma de pagamento.</p>
        </div>
    </header>

    <form asp-controller="Checkout" asp-action="ConfirmOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SelectedAddressId" id="selectedAddressId" />

        <div class="checkout-content">
            <main class="checkout-main">

                <div class="text-danger">
                    <div asp-validation-summary="ModelOnly"></div>
                    @if (TempData["ErroPagamento"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> @TempData["ErroPagamento"]
                        </div>
                    }
                </div>

                <section class="card-block">
                    <div class="block-heading">
                        <div class="block-title">
                            <span class="icon-circle"><i class="fas fa-user-check"></i></span>
                            <div>
                                <h2>Dados do comprador</h2>
                                <p>Identificação para a nota fiscal e contato.</p>
                            </div>
                        </div>
                    </div>

                    <div class="block-grid two-cols">
                        <div class="input-field">
                            <label asp-for="CheckoutName">Nome completo</label>
                            <input asp-for="CheckoutName" type="text" placeholder="Ex: Mariana Souza" autocomplete="name" />
                            <span asp-validation-for="CheckoutName" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutDocument">CPF / CNPJ</label>
                            <input asp-for="CheckoutDocument" type="text" placeholder="000.000.000-00" />
                            <span asp-validation-for="CheckoutDocument" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutEmail">E-mail</label>
                            <input asp-for="CheckoutEmail" type="email" placeholder="voce@email.com" autocomplete="email" />
                            <span asp-validation-for="CheckoutEmail" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutPhone">Telefone</label>
                            <input asp-for="CheckoutPhone" type="tel" placeholder="(71) 99999-0000" />
                            <span asp-validation-for="CheckoutPhone" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="card-block">
                    <div class="block-heading">
                        <div class="block-title">
                            <span class="icon-circle"><i class="fas fa-map-marker-alt"></i></span>
                            <div>
                                <h2>Endereço de Entrega</h2>
                                <p>Selecione onde você quer receber o produto.</p>
                            </div>
                        </div>
                    </div>

                    <div class="address-list" id="addressList">
                        @if (Model.Addresses != null && Model.Addresses.Any())
                        {
                            foreach (var address in Model.Addresses)
                            {
                                var isSelected = address.Id == Model.SelectedAddressId;
                                <article class="address-card @(isSelected ? "is-selected" : string.Empty)" data-address-id="@address.Id">
                                    <header>
                                        <h3>@address.Label</h3>
                                        @if (address.IsPrimary)
                                        {
                                            <span class="pill">Principal</span>
                                        }
                                    </header>

                                    <p>@address.Street, @(address.GetType().GetProperty("Numero") != null ? address.GetType().GetProperty("Numero").GetValue(address, null) : "")</p>

                                    <p>@address.CityState - @address.Cep</p>
                                </article>
                            }
                        }
                        else
                        {
                            <p class="address-empty">Nenhum endereço salvo. Preencha os campos abaixo.</p>
                        }
                    </div>

                    <div class="block-grid three-cols" style="margin-top: 1.5rem;">
                        <div class="input-field">
                            <label asp-for="CheckoutCep">CEP</label>
                            <input asp-for="CheckoutCep" type="text" placeholder="00000-000" inputmode="numeric" />
                            <span asp-validation-for="CheckoutCep" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutEstado">Estado</label>
                            <select asp-for="CheckoutEstado">
                                <option value="">UF</option>
                                <option>SP</option>
                                <option>RJ</option>
                                <option>MG</option>
                                <option>BA</option>
                                <option>RS</option>
                                <option>PR</option>
                                <option>SC</option>
                                <option>ES</option>
                            </select>
                            <span asp-validation-for="CheckoutEstado" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutCidade">Cidade</label>
                            <input asp-for="CheckoutCidade" type="text" />
                            <span asp-validation-for="CheckoutCidade" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutEndereco">Endereço</label>
                            <input asp-for="CheckoutEndereco" type="text" />
                            <span asp-validation-for="CheckoutEndereco" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutNumero">Número</label>
                            <input asp-for="CheckoutNumero" type="text" />
                            <span asp-validation-for="CheckoutNumero" class="text-danger"></span>
                        </div>
                        <div class="input-field">
                            <label asp-for="CheckoutComplemento">Complemento</label>
                            <input asp-for="CheckoutComplemento" type="text" />
                        </div>
                    </div>
                </section>

                <section class="card-block">
                    <div class="block-heading">
                        <div class="block-title">
                            <span class="icon-circle"><i class="fas fa-truck"></i></span>
                            <div>
                                <h2>Método de Envio</h2>
                                @if (isQualifiedForDelivery)
                                {
                                    <p>Receba em casa ou retire na loja.</p>
                                }
                                else
                                {

                                    <p class="text-warning">Para pedidos pequenos, apenas retirada disponível.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="shipping-options">
                        @if (shippingOptions != null && shippingOptions.Any())
                        {
                            foreach (var option in shippingOptions)
                            {
                                var isSelected = option.Value.Equals(selectedShippingMethod, StringComparison.OrdinalIgnoreCase);
                                <label class="shipping-card @(isSelected ? "is-selected" : string.Empty)"
                                       data-shipping-price="@option.Price.ToString(CultureInfo.InvariantCulture)"
                                       data-shipping-label="@option.Title">
                                    <input type="radio" name="ShippingMethod" value="@option.Value" @(isSelected ? "checked" : null) />
                                    <div class="shipping-card-content">
                                        <div>
                                            <h3>@option.Title</h3>
                                            <p>@option.Description</p>
                                        </div>
                                        <strong>@(option.Price <= 0 ? "Grátis" : option.Price.ToString("C", culture))</strong>
                                    </div>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Nenhuma opção de entrega disponível.</p>
                        }
                    </div>
                    <span asp-validation-for="ShippingMethod" class="text-danger"></span>
                </section>

                <section class="card-block">
                    <div class="block-heading">
                        <div class="block-title">
                            <span class="icon-circle"><i class="fas fa-credit-card"></i></span>
                            <div>
                                <h2>Pagamento</h2>
                                <p>Ambiente seguro Mercado Pago.</p>
                            </div>
                        </div>
                        <div class="card-badges">
                            <span class="pill">Seguro</span>
                            <span class="pill">Criptografado</span>
                        </div>
                    </div>

                    <div class="payment-tabs" id="paymentTabs">
                        @foreach (var option in Model.PaymentOptions)
                        {
                            var isActive = option.Value.Equals(selectedPayment, StringComparison.OrdinalIgnoreCase);
                            <button type="button" data-payment="@option.Value" class="payment-tab @(isActive ? "is-active" : string.Empty)">
                                <i class="@option.IconCss"></i> @option.Label
                            </button>
                        }
                    </div>
                    <input type="hidden" asp-for="PaymentMethod" id="paymentMethodField" />
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>

                    <div class="payment-panels">

                        <div class="payment-panel @(selectedPayment.Equals("card", StringComparison.OrdinalIgnoreCase) ? "is-visible" : string.Empty)" data-payment-panel="card">
                            <div class="payment-info-box">
                                <i class="fas fa-external-link-alt"></i>
                                <strong>Você será redirecionado para o Mercado Pago</strong>
                                <p>Lá você poderá usar seu cartão de crédito com segurança total.</p>
                                <small>Aceitamos Visa, Mastercard, Elo, Hipercard e outros.</small>
                            </div>
                        </div>

                        <div class="payment-panel @(selectedPayment.Equals("pix", StringComparison.OrdinalIgnoreCase) ? "is-visible" : string.Empty)" data-payment-panel="pix">
                            <div class="payment-info-box">
                                <i class="brands fa-pix"></i> <strong>Pagamento Instantâneo via Pix</strong>
                                <p>Ao confirmar, você será redirecionado para gerar seu QR Code.</p>
                                <small>Aprovação imediata.</small>
                            </div>
                        </div>

                        <div class="payment-panel @(selectedPayment.Equals("boleto", StringComparison.OrdinalIgnoreCase) ? "is-visible" : string.Empty)" data-payment-panel="boleto">
                            <div class="payment-info-box">
                                <i class="fas fa-barcode"></i>
                                <strong>Boleto Bancário</strong>
                                <p>Você será redirecionado para imprimir ou copiar o código do boleto.</p>
                                <small>Aprovação em 1 a 2 dias úteis.</small>
                            </div>
                        </div>
                    </div>
                </section>

            </main>

            <aside class="checkout-sidebar">
                <section class="card-block sticky-summary">
                    <div class="summary-header">
                        <h3>Resumo do pedido</h3>
                        <a asp-controller="Carrinho" asp-action="Index" class="btn-link">Voltar</a>
                    </div>

                    <ul class="summary-items">
                        @if (Model.CartItems != null && Model.CartItems.Any())
                        {
                            foreach (var item in Model.CartItems)
                            {
                                <li>
                                    <div>
                                        <strong>@item.Nome</strong>
                                        <span>Qtd: @item.Quantidade</span>
                                    </div>
                                    <span>@item.Total.ToString("C", culture)</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li>O carrinho está vazio.</li>
                        }
                    </ul>

                    <div class="summary-coupon">
                        <input type="text" asp-for="CouponInput" placeholder="Cupom de desconto" />
                        <button type="button" id="applyCouponButton">Aplicar</button>
                    </div>

                    <dl class="summary-totals">
                        <div>
                            <dt>Subtotal</dt>
                            <dd id="summarySubtotal">@Model.Subtotal.ToString("C", culture)</dd>
                            <input type="hidden" asp-for="Subtotal" id="hiddenSubtotal" />
                        </div>
                        <div>
                            <dt>Entrega</dt>
                            <dd id="summaryShipping">@shippingSummaryText</dd>
                        </div>
                        <div>
                            <dt>Descontos</dt>
                            <dd class="text-success" id="summaryDiscounts">- @Model.Discount.ToString("C", culture)</dd>
                            <input type="hidden" asp-for="Discount" id="hiddenDiscount" />
                        </div>
                    </dl>

                    <div class="summary-total">
                        <span>Total</span>
                        <strong id="summaryTotal">@Model.Total.ToString("C", culture)</strong>
                        <input type="hidden" asp-for="Total" id="hiddenTotal" />
                    </div>

                    <button type="submit" class="btn-primary btn-full" id="confirmOrderButton">
                        Pagar com Mercado Pago <i class="fas fa-lock"></i>
                    </button>

                    <p class="summary-safe-text">
                        <i class="fas fa-shield-alt"></i> Compra 100% segura e monitorada.
                    </p>
                </section>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}